<views:ThemedWindow x:Class="Sortify.Views.ChartTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sortify.Views"
        Title="Chart Numbers" Height="560" Width="640" MinHeight="320" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                <DataGrid x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Extended" />
            </DockPanel>
        </Border>

        <TextBlock x:Name="ResultText" Grid.Row="1" Style="{StaticResource Hint}" FontSize="11" Margin="0,10,0,0"
                   AutomationProperties.LiveSetting="Polite"
                   Text="Copy as CSV puts every row on the clipboard, ready to paste into a spreadsheet." />

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Margin="0" IsCancel="True" Click="OnClose" />
            <Button DockPanel.Dock="Right" Content="Copy as CSV" Style="{StaticResource AccentButton}"
                    Click="OnCopy" IsDefault="True" />
        </DockPanel>
    </Grid>
</views:ThemedWindow>
