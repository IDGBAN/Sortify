<views:ThemedWindow x:Class="Sortify.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sortify.Views"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Details" Height="760" Width="1080"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="Text" Value="Double-click a row, or press Enter, for its own breakdown" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="Open in Spotify"
                    Click="OnOpenInSpotify" Style="{StaticResource AccentButton}"
                    Padding="12,6" Margin="0" VerticalAlignment="Top" />
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy summary" Click="OnCopySummary"
                    Padding="12,6" VerticalAlignment="Top"
                    ToolTip="Copy these figures as plain text" />
            <Button x:Name="YearReviewButton" DockPanel.Dock="Right" Content="Year in review image"
                    Click="OnYearReview" Padding="12,6" VerticalAlignment="Top" Visibility="Collapsed"
                    ToolTip="Make a shareable picture of this year: top artists, top tracks and the big numbers" />
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource MutedBrush}"
                           FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="5">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="TIME LISTENED" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="TotalTimeText" Style="{StaticResource StatValueSmall}" FontSize="15" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="PLAYS" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="PlaysText" Style="{StaticResource StatValueSmall}" FontSize="15" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ACTIVE DAYS" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="ActiveDaysText" Style="{StaticResource StatValueSmall}" FontSize="15" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="FIRST PLAYED" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="FirstPlayedText" Style="{StaticResource StatValueSmall}" FontSize="15" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="LAST PLAYED" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="LastPlayedText" Style="{StaticResource StatValueSmall}" FontSize="15" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Height="280">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Listening Over Time (monthly)"
                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                        <lvc:CartesianChart x:Name="MonthChart" Background="Transparent" TooltipPosition="Top" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Height="260">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Listening by Hour of Day"
                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                        <lvc:CartesianChart x:Name="HourChart" Background="Transparent" />
                    </DockPanel>
                </Border>

                <!-- Only populated for a year, which is the one scope spanning many artists. -->
                <Border x:Name="ArtistsCard" Style="{StaticResource Card}" Height="300">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock x:Name="ArtistsHint" DockPanel.Dock="Right" Style="{StaticResource RowHint}" />
                            <TextBlock Text="Artists" Style="{StaticResource SectionHeader}" Margin="0" />
                        </DockPanel>
                        <DataGrid x:Name="ArtistsGrid" AutomationProperties.Name="Artists"
                                  MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="2*" />
                                <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}"
                                                    Width="Auto" SortMemberPath="TotalMsPlayed" />
                                <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="Auto" />
                                <DataGridTextColumn Header="First Played"
                                                    Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border x:Name="TracksCard" Style="{StaticResource Card}" Height="300">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock x:Name="TracksHint" DockPanel.Dock="Right" Style="{StaticResource RowHint}" />
                            <TextBlock x:Name="TracksHeader" Text="Tracks" Style="{StaticResource SectionHeader}" Margin="0" />
                        </DockPanel>
                        <DataGrid x:Name="TracksGrid" AutomationProperties.Name="Tracks"
                                  MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Track" Binding="{Binding Track}" Width="2*" />
                                <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" />
                                <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}"
                                                    Width="Auto" SortMemberPath="TotalMsPlayed" />
                                <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="Auto" />
                                <DataGridTextColumn Header="First Played"
                                                    Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd}" Width="Auto" />
                                <DataGridTextColumn Header="Last Played"
                                                    Binding="{Binding LastPlayed, StringFormat=yyyy-MM-dd}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border x:Name="AlbumsCard" Style="{StaticResource Card}" Height="260">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock x:Name="AlbumsHint" DockPanel.Dock="Right" Style="{StaticResource RowHint}" />
                            <TextBlock Text="Albums" Style="{StaticResource SectionHeader}" Margin="0" />
                        </DockPanel>
                        <DataGrid x:Name="AlbumsGrid" AutomationProperties.Name="Albums"
                                  MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="2*" />
                                <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" />
                                <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}"
                                                    Width="Auto" SortMemberPath="TotalMsPlayed" />
                                <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="Auto" />
                                <DataGridTextColumn Header="First Played"
                                                    Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</views:ThemedWindow>
