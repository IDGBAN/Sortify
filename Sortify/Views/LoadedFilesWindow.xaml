<views:ThemedWindow x:Class="Sortify.Views.LoadedFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sortify.Views"
        Title="What Was Loaded" Height="560" Width="640" MinHeight="360" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SourceText" Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0" />
                <TextBlock x:Name="DuplicatesText" Style="{StaticResource Hint}" FontSize="11" Margin="0,4,0,0" />
                <Border x:Name="AccountDataNote" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource PanelBrush2}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Text="Only the account-data export is loaded. It keeps about a year of plays and, for each, just the track, the artist and the minute it ended. Albums, Spotify links, devices, countries, skips and shuffle aren't in it, and podcasts are mixed in with the music, so the parts of Sortify built on those stay empty. Request your extended streaming history from Spotify's privacy page to fill them in." />
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="FilesCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Files" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="FilesList" AutomationProperties.Name="Files that were read">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       ToolTip="{Binding Path}" />
                                            <TextBlock Text="{Binding Details}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Format}" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource AccentButton}"
                    Margin="0" Padding="24,8" IsDefault="True" IsCancel="True" Click="OnClose" />
        </DockPanel>
    </Grid>
</views:ThemedWindow>
