<UserControl x:Class="Sortify.Views.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sortify.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:FilterViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="280">
    <UserControl.Resources>
        <!-- An item template rather than DisplayMemberPath: the closed box in the app's
             ComboBox template only shows the selection through a template. -->
        <DataTemplate x:Key="PlaybackChoiceItem">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>

        <DataTemplate x:Key="ChoiceToggleItem">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" MinWidth="56"
                      Margin="0,0,8,2" ToolTip="{Binding Description}"
                      AutomationProperties.Name="{Binding Description}" />
        </DataTemplate>

        <!-- Removable pill used by both exclusion lists. -->
        <Style x:Key="ExclusionPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush2}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             To="0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Filters" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetCommand}"
                            Padding="8,4" Margin="0" ToolTip="Clear every filter (Ctrl+R)" />
                </DockPanel>

                <!-- Saved filter sets -->
                <TextBlock Text="SAVED FILTERS" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- An item template rather than DisplayMemberPath: the closed box in the
                         app's ComboBox template only shows the selection through a template. -->
                    <ComboBox Grid.Column="0" ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset}" IsEnabled="{Binding HasPresets}"
                              AutomationProperties.Name="Saved filter sets"
                              ToolTip="Pick a saved set to put all of its filters back">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="0" Text="{Binding PresetPrompt}" Margin="11,0,0,0" FontSize="13"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource MutedBrush}"
                               Visibility="{Binding HasSelectedPreset, Converter={StaticResource NotBoolToVis}}" />
                    <Button Grid.Column="1" Content="Delete" Margin="6,0,0,0" Padding="10,4"
                            Command="{Binding DeletePresetCommand}"
                            ToolTip="Forget the selected saved set (the filters stay as they are)" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="40" AutomationProperties.Name="Name for the current filters"
                             ToolTip="Name the current filters, then press Enter or Save">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SavePresetCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Save" Margin="6,0,0,0" Padding="10,4"
                            Command="{Binding SavePresetCommand}" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Saves every filter below under a name, and picking it puts them all back. Saving under a name that's already taken replaces it. Exclusions (unticked devices and countries too), the minimum duration, and the podcast and private-session settings carry over between launches anyway." />

                <!-- Minimum play duration -->
                <TextBlock Text="MINIMUM PLAY DURATION (SECONDS)" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding MinSeconds, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                         AutomationProperties.Name="Minimum play duration in seconds"
                         MaxLength="6"
                         PreviewTextInput="OnDigitsOnlyInput"
                         DataObject.Pasting="OnDigitsOnlyPaste" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Listens shorter than this are ignored (default 5s)." />

                <!-- Content -->
                <TextBlock Text="CONTENT" Style="{StaticResource SectionHeader}" />
                <CheckBox Content="Count podcasts and audiobooks"
                          IsChecked="{Binding IncludePodcasts}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off by default so shows don't outrank your music. The Podcasts tab always shows them." />

                <!-- Date range -->
                <TextBlock Text="DATE RANGE" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="From" Style="{StaticResource Caption}" />
                <DatePicker SelectedDate="{Binding StartDate}" AutomationProperties.Name="Filter from date" />
                <TextBlock Text="To" Style="{StaticResource Caption}" />
                <DatePicker SelectedDate="{Binding EndDate}" AutomationProperties.Name="Filter to date" />
                <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}"
                           Text="From is after To, so nothing can match. Swap the dates or clear one."
                           AutomationProperties.LiveSetting="Assertive"
                           Visibility="{Binding HasInvalidDateRange, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding QuickRanges}" Margin="0,8,0,0" Focusable="False"
                              AutomationProperties.Name="Quick date ranges"
                              Visibility="{Binding HasQuickRanges, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Style="{StaticResource QuickRangeButton}"
                                    ToolTip="{Binding Tooltip}"
                                    AutomationProperties.HelpText="{Binding Tooltip}"
                                    Command="{Binding DataContext.ApplyQuickRangeCommand,
                                               RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Search -->
                <TextBlock Text="SEARCH ALL PLAYS" Style="{StaticResource SectionHeader}" />
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                         AutomationProperties.Name="Search all plays" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Matches a track, artist, album or show name and re-runs the whole analysis. To narrow just the rows in a table, use the filter box above it." />

                <!-- Time of day -->
                <TextBlock Text="TIME OF DAY" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="Start hour: " />
                            <Run Text="{Binding StartHour}" FontWeight="Bold" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="23" Value="{Binding StartHour}" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Start hour" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="End hour: " />
                            <Run Text="{Binding EndHour}" FontWeight="Bold" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="23" Value="{Binding EndHour}" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="End hour" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Tip: set start &gt; end to span midnight (e.g. 22 to 2)." />

                <!-- Day of week -->
                <TextBlock Text="DAYS OF WEEK" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Width="56" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Playback context -->
                <TextBlock Text="PLAYBACK" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="Shuffle" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding ShuffleChoices}" SelectedValuePath="Mode"
                          SelectedValue="{Binding ShuffleMode}" ItemTemplate="{StaticResource PlaybackChoiceItem}"
                          AutomationProperties.Name="Shuffled plays" />
                <TextBlock Text="Offline" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding OfflineChoices}" SelectedValuePath="Mode"
                          SelectedValue="{Binding OfflineMode}" ItemTemplate="{StaticResource PlaybackChoiceItem}"
                          AutomationProperties.Name="Offline plays" />
                <TextBlock Text="Private sessions" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding PrivateChoices}" SelectedValuePath="Mode"
                          SelectedValue="{Binding PrivateMode}" ItemTemplate="{StaticResource PlaybackChoiceItem}"
                          AutomationProperties.Name="Private sessions" />

                <TextBlock Text="Devices" Style="{StaticResource Caption}" Margin="0,12,0,3" />
                <ItemsControl ItemsSource="{Binding Devices}" Focusable="False"
                              AutomationProperties.Name="Devices to count"
                              ItemTemplate="{StaticResource ChoiceToggleItem}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Countries" Style="{StaticResource Caption}" Margin="0,8,0,3" />
                <ItemsControl ItemsSource="{Binding Countries}" Focusable="False"
                              AutomationProperties.Name="Countries to count"
                              ItemTemplate="{StaticResource ChoiceToggleItem}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Style="{StaticResource Hint}"
                           Visibility="{Binding HasPlaybackChoices, Converter={StaticResource NotBoolToVis}}"
                           Text="The devices and countries in your history show up here once it's loaded." />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Untick a device or country to leave its plays out. Older exports don't record any of this, so their plays always count, except when a list above is set to Only." />

                <!-- Excluded artists -->
                <TextBlock Text="EXCLUDE ARTISTS" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewExcludedArtist, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Artist name to exclude">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddExcludedArtistCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Padding="10,4"
                            Command="{Binding AddExcludedArtistCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ExcludedArtists}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ExclusionPill}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-10" />
                                </Border.RenderTransform>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button DockPanel.Dock="Right" Content="x" Padding="6,0" Margin="0"
                                            ToolTip="Stop excluding this"
                                            AutomationProperties.Name="{Binding StringFormat='Stop excluding artist {0}'}"
                                            Command="{Binding DataContext.RemoveExcludedArtistCommand,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Excluded tracks -->
                <TextBlock Text="EXCLUDE TRACKS" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewExcludedTrack, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Track name to exclude">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddExcludedTrackCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Padding="10,4"
                            Command="{Binding AddExcludedTrackCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ExcludedTracks}" Margin="0,6,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ExclusionPill}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-10" />
                                </Border.RenderTransform>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button DockPanel.Dock="Right" Content="x" Padding="6,0" Margin="0"
                                            ToolTip="Stop excluding this"
                                            AutomationProperties.Name="{Binding StringFormat='Stop excluding track {0}'}"
                                            Command="{Binding DataContext.RemoveExcludedTrackCommand,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
