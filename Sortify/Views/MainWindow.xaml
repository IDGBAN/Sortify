<Window x:Class="Sortify.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:Sortify.ViewModels"
        xmlns:views="clr-namespace:Sortify.Views"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="Sortify" Height="900" Width="1500" MinHeight="620" MinWidth="900"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen" Opacity="0"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnFileDragOver">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding RunAnalysisCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="O" Command="{Binding OpenFolderCommand}" />
    </Window.InputBindings>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Sortify" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,16,0" />
                <Button Content="Run Analysis" Style="{StaticResource AccentButton}"
                        ToolTip="Pick individual history JSON files (Ctrl+O)"
                        Command="{Binding RunAnalysisCommand}" />
                <Button Content="Open Folder"
                        ToolTip="Pick the extracted export folder; history files are found automatically (Ctrl+Shift+O)"
                        Command="{Binding OpenFolderCommand}" />
                <Button Content="Export TXT" Command="{Binding ExportTxtCommand}" />
                <Button Content="Export Tracks CSV" Command="{Binding ExportTracksCsvCommand}" />
                <Button Content="Export Artists CSV" Command="{Binding ExportArtistsCsvCommand}" />
                <Button Content="Export Albums CSV" Command="{Binding ExportAlbumsCsvCommand}" />
                <Button Content="Export Years CSV" Command="{Binding ExportYearsCsvCommand}" />

                <ProgressBar DockPanel.Dock="Right" Width="120" Height="6" IsIndeterminate="True"
                             VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                             Background="Transparent" BorderThickness="0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:FilterPanel Grid.Column="0" DataContext="{Binding Filters}" />

            <TabControl Grid.Column="1" Margin="6,8,6,0" SelectionChanged="OnTabSelectionChanged">
                <!-- OVERVIEW -->
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="5" Margin="0,6,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL TIME" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding TotalTimeText}" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL PLAYS" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding TotalPlaysText}" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="UNIQUE ARTISTS" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding UniqueArtistsText}" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="UNIQUE TRACKS" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding UniqueTracksText}" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="DATE RANGE" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding DateRangeText}" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}" Height="520">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Top 25 Artists - Share of Listening Time"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                    <lvc:PieChart Series="{Binding ArtistShareSeries}"
                                                  Background="Transparent"
                                                  LegendPosition="Bottom" LegendTextSize="12" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Height="320">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Listening Over Time"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                    <lvc:CartesianChart Series="{Binding OverTimeSeries}"
                                                        Background="Transparent"
                                                        XAxes="{Binding OverTimeX}" YAxes="{Binding OverTimeY}"
                                                        TooltipPosition="Top" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TRACKS -->
                <TabItem Header="Tracks">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="460" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Top Tracks" Style="{StaticResource SectionHeader}"
                                               Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="{StaticResource PanelBrush2}" CornerRadius="8" Padding="3"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="TracksTimeToggle" Content="By Time"
                                                         GroupName="TracksMetric" IsChecked="True"
                                                         Style="{StaticResource SegmentToggle}" />
                                            <RadioButton x:Name="TracksCountToggle" Content="By Plays"
                                                         GroupName="TracksMetric"
                                                         Background="{StaticResource Accent2Brush}"
                                                         Style="{StaticResource SegmentToggle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  ScrollChanged="OnTracksScrollChanged"
                                                  Visibility="{Binding IsChecked, ElementName=TracksTimeToggle, Converter={StaticResource BoolToVis}}">
                                        <lvc:CartesianChart Series="{Binding TracksByTimeSeries}"
                                                            Background="Transparent" Height="{Binding TracksChartHeight}"
                                                            TooltipPosition="Hidden"
                                                            AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                            XAxes="{Binding TracksByTimeX}" YAxes="{Binding TracksByTimeY}" />
                                    </ScrollViewer>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  ScrollChanged="OnTracksScrollChanged"
                                                  Visibility="{Binding IsChecked, ElementName=TracksCountToggle, Converter={StaticResource BoolToVis}}">
                                        <lvc:CartesianChart Series="{Binding TracksByCountSeries}"
                                                            Background="Transparent" Height="{Binding TracksChartHeight}"
                                                            TooltipPosition="Hidden"
                                                            AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                            XAxes="{Binding TracksByCountX}" YAxes="{Binding TracksByCountY}" />
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <DataGrid x:Name="TracksGrid" ItemsSource="{Binding Tracks}"
                                      PreviewMouseRightButtonDown="OnGridRightClick"
                                      MouseDoubleClick="OnTracksGridDoubleClick">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy track" Click="OnCopyTrackFromTracks" />
                                        <MenuItem Header="Copy artist" Click="OnCopyArtistFromTracks" />
                                        <Separator />
                                        <MenuItem Header="Exclude this track" Click="OnExcludeTrackFromTracks" />
                                        <MenuItem Header="Exclude this artist" Click="OnExcludeArtistFromTracks" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Track" Binding="{Binding Track}" Width="2*" />
                                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" />
                                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}"
                                                        Width="Auto" SortMemberPath="TotalMsPlayed" />
                                    <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="Auto" />
                                    <DataGridTextColumn Header="First Played"
                                                        Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd HH:mm}"
                                                        Width="Auto" />
                                    <DataGridTextColumn Header="Last Played"
                                                        Binding="{Binding LastPlayed, StringFormat=yyyy-MM-dd HH:mm}"
                                                        Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ARTISTS -->
                <TabItem Header="Artists">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="460" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Top Artists" Style="{StaticResource SectionHeader}"
                                               Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="{StaticResource PanelBrush2}" CornerRadius="8" Padding="3"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ArtistsTimeToggle" Content="By Time"
                                                         GroupName="ArtistsMetric" IsChecked="True"
                                                         Style="{StaticResource SegmentToggle}" />
                                            <RadioButton x:Name="ArtistsCountToggle" Content="By Plays"
                                                         GroupName="ArtistsMetric"
                                                         Background="{StaticResource Accent2Brush}"
                                                         Style="{StaticResource SegmentToggle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  ScrollChanged="OnArtistsScrollChanged"
                                                  Visibility="{Binding IsChecked, ElementName=ArtistsTimeToggle, Converter={StaticResource BoolToVis}}">
                                        <lvc:CartesianChart Series="{Binding ArtistsByTimeSeries}"
                                                            Background="Transparent" Height="{Binding ArtistsChartHeight}"
                                                            TooltipPosition="Hidden"
                                                            AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                            XAxes="{Binding ArtistsByTimeX}" YAxes="{Binding ArtistsByTimeY}" />
                                    </ScrollViewer>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  ScrollChanged="OnArtistsScrollChanged"
                                                  Visibility="{Binding IsChecked, ElementName=ArtistsCountToggle, Converter={StaticResource BoolToVis}}">
                                        <lvc:CartesianChart Series="{Binding ArtistsByCountSeries}"
                                                            Background="Transparent" Height="{Binding ArtistsChartHeight}"
                                                            TooltipPosition="Hidden"
                                                            AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                            XAxes="{Binding ArtistsByCountX}" YAxes="{Binding ArtistsByCountY}" />
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <DataGrid x:Name="ArtistsGrid" ItemsSource="{Binding Artists}"
                                      PreviewMouseRightButtonDown="OnGridRightClick"
                                      MouseDoubleClick="OnArtistsGridDoubleClick">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy artist" Click="OnCopyArtistFromArtists" />
                                        <Separator />
                                        <MenuItem Header="Exclude this artist" Click="OnExcludeArtistFromArtists" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="2*" />
                                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}"
                                                        Width="Auto" SortMemberPath="TotalMsPlayed" />
                                    <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="Auto" />
                                    <DataGridTextColumn Header="First Track" Binding="{Binding FirstTrack}" Width="*" />
                                    <DataGridTextColumn Header="First Played"
                                                        Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd HH:mm}"
                                                        Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ALBUMS -->
                <TabItem Header="Albums">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="460" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Top Albums" Style="{StaticResource SectionHeader}"
                                               Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="{StaticResource PanelBrush2}" CornerRadius="8" Padding="3"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="AlbumsTimeToggle" Content="By Time"
                                                         GroupName="AlbumsMetric" IsChecked="True"
                                                         Style="{StaticResource SegmentToggle}" />
                                            <RadioButton x:Name="AlbumsCountToggle" Content="By Plays"
                                                         GroupName="AlbumsMetric"
                                                         Background="{StaticResource Accent2Brush}"
                                                         Style="{StaticResource SegmentToggle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  ScrollChanged="OnAlbumsScrollChanged"
                                                  Visibility="{Binding IsChecked, ElementName=AlbumsTimeToggle, Converter={StaticResource BoolToVis}}">
                                        <lvc:CartesianChart Series="{Binding AlbumsByTimeSeries}"
                                                            Background="Transparent" Height="{Binding AlbumsChartHeight}"
                                                            TooltipPosition="Hidden"
                                                            AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                            XAxes="{Binding AlbumsByTimeX}" YAxes="{Binding AlbumsByTimeY}" />
                                    </ScrollViewer>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  ScrollChanged="OnAlbumsScrollChanged"
                                                  Visibility="{Binding IsChecked, ElementName=AlbumsCountToggle, Converter={StaticResource BoolToVis}}">
                                        <lvc:CartesianChart Series="{Binding AlbumsByCountSeries}"
                                                            Background="Transparent" Height="{Binding AlbumsChartHeight}"
                                                            TooltipPosition="Hidden"
                                                            AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                            XAxes="{Binding AlbumsByCountX}" YAxes="{Binding AlbumsByCountY}" />
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <DataGrid x:Name="AlbumsGrid" ItemsSource="{Binding Albums}"
                                      PreviewMouseRightButtonDown="OnGridRightClick"
                                      MouseDoubleClick="OnAlbumsGridDoubleClick">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy album" Click="OnCopyAlbumFromAlbums" />
                                        <MenuItem Header="Copy artist" Click="OnCopyArtistFromAlbums" />
                                        <Separator />
                                        <MenuItem Header="Exclude this artist" Click="OnExcludeArtistFromAlbums" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="2*" />
                                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" />
                                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}"
                                                        Width="Auto" SortMemberPath="TotalMsPlayed" />
                                    <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="Auto" />
                                    <DataGridTextColumn Header="First Played"
                                                        Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd HH:mm}"
                                                        Width="Auto" />
                                    <DataGridTextColumn Header="Last Played"
                                                        Binding="{Binding LastPlayed, StringFormat=yyyy-MM-dd HH:mm}"
                                                        Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- YEARS -->
                <TabItem Header="Years">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="320" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Listening Time per Year"
                                           Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <lvc:CartesianChart Series="{Binding YearSeries}"
                                                    Background="Transparent"
                                                    XAxes="{Binding YearX}" YAxes="{Binding YearY}" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <DataGrid ItemsSource="{Binding Years}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="Auto" />
                                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N1}"
                                                        Width="Auto" SortMemberPath="TotalMsPlayed" />
                                    <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="Auto" />
                                    <DataGridTextColumn Header="Unique Artists" Binding="{Binding UniqueArtists}" Width="Auto" />
                                    <DataGridTextColumn Header="Unique Tracks" Binding="{Binding UniqueTracks}" Width="Auto" />
                                    <DataGridTextColumn Header="Top Artist" Binding="{Binding TopArtist}" Width="*" />
                                    <DataGridTextColumn Header="Top Track" Binding="{Binding TopTrack}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- PODCASTS -->
                <TabItem Header="Podcasts">
                    <Grid>
                        <!-- Nothing to show until an export actually contains shows. -->
                        <TextBlock Text="No podcasts or audiobooks were found in this history."
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoPodcastData, Converter={StaticResource BoolToVis}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasPodcastData, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <UniformGrid Columns="4" Margin="0,6,0,0">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="TIME LISTENED" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding PodcastTimeText}" FontSize="16" FontWeight="Bold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="PLAYS" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding PodcastPlaysText}" FontSize="16" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="SHOWS" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding UniqueShowsText}" FontSize="16" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="EPISODES" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding UniqueEpisodesText}" FontSize="16" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Top Shows and Audiobooks (top 20)"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                        <lvc:CartesianChart Series="{Binding ShowSeries}"
                                                            Background="Transparent"
                                                            Height="{Binding ShowsChartHeight}"
                                                            TooltipPosition="Hidden"
                                                            XAxes="{Binding ShowX}" YAxes="{Binding ShowY}" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Top Episodes and Chapters (top 20)"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                        <lvc:CartesianChart Series="{Binding EpisodeSeries}"
                                                            Background="Transparent"
                                                            Height="{Binding EpisodesChartHeight}"
                                                            TooltipPosition="Hidden"
                                                            XAxes="{Binding EpisodeX}" YAxes="{Binding EpisodeY}" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Height="320">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Shows" Style="{StaticResource SectionHeader}"
                                                   Margin="0,0,0,8" />
                                        <DataGrid ItemsSource="{Binding Shows}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Show" Binding="{Binding Show}" Width="2*" />
                                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="Auto" />
                                                <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}"
                                                                    Width="Auto" SortMemberPath="TotalMsPlayed" />
                                                <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="Auto" />
                                                <DataGridTextColumn Header="Episodes" Binding="{Binding EpisodeCount}" Width="Auto" />
                                                <DataGridTextColumn Header="First Played"
                                                                    Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd}"
                                                                    Width="Auto" />
                                                <DataGridTextColumn Header="Last Played"
                                                                    Binding="{Binding LastPlayed, StringFormat=yyyy-MM-dd}"
                                                                    Width="Auto" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Height="320">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Episodes" Style="{StaticResource SectionHeader}"
                                                   Margin="0,0,0,8" />
                                        <DataGrid ItemsSource="{Binding Episodes}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Episode" Binding="{Binding Episode}" Width="2*" />
                                                <DataGridTextColumn Header="Show" Binding="{Binding Show}" Width="*" />
                                                <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}"
                                                                    Width="Auto" SortMemberPath="TotalMsPlayed" />
                                                <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="Auto" />
                                                <DataGridTextColumn Header="First Played"
                                                                    Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd}"
                                                                    Width="Auto" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- TRENDS -->
                <TabItem Header="Trends">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Height="320">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock Text="Listening Over Time" Style="{StaticResource SectionHeader}"
                                                   Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="{StaticResource PanelBrush2}" CornerRadius="8" Padding="3"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Daily" GroupName="OverTimeGran" IsChecked="True"
                                                             Tag="Daily" Checked="OnGranularityChecked"
                                                             Style="{StaticResource SegmentToggle}" />
                                                <RadioButton Content="Weekly" GroupName="OverTimeGran"
                                                             Tag="Weekly" Checked="OnGranularityChecked"
                                                             Style="{StaticResource SegmentToggle}" />
                                                <RadioButton Content="Monthly" GroupName="OverTimeGran"
                                                             Tag="Monthly" Checked="OnGranularityChecked"
                                                             Style="{StaticResource SegmentToggle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <lvc:CartesianChart Series="{Binding OverTimeSeries}"
                                                        Background="Transparent"
                                                        XAxes="{Binding OverTimeX}" YAxes="{Binding OverTimeY}"
                                                        TooltipPosition="Top" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Height="340">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Listening Heatmap (day of week vs. hour of day)"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                    <lvc:CartesianChart Series="{Binding HeatSeries}"
                                                        Background="Transparent"
                                                        XAxes="{Binding HeatX}" YAxes="{Binding HeatY}"
                                                        TooltipPosition="Hidden" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Height="300">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="New Artists Discovered per Month"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                    <lvc:CartesianChart Series="{Binding DiscoverySeries}"
                                                        Background="Transparent"
                                                        XAxes="{Binding DiscoveryX}" YAxes="{Binding DiscoveryY}"
                                                        TooltipPosition="Top" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Height="300">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Listening by Hour of Day"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                    <lvc:CartesianChart Series="{Binding HourSeries}"
                                                        Background="Transparent"
                                                        XAxes="{Binding HourX}" YAxes="{Binding HourY}" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Height="300">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Listening by Day of Week"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                    <lvc:CartesianChart Series="{Binding DayOfWeekSeries}"
                                                        Background="Transparent"
                                                        XAxes="{Binding DayOfWeekX}" YAxes="{Binding DayOfWeekY}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- INSIGHTS -->
                <TabItem Header="Insights">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="3" Margin="0,6,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="LONGEST STREAK" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding LongestStreakText}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Consecutive days with listening."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="CURRENT STREAK" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding CurrentStreakText}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Consecutive days ending on your most recent listening day."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="BIGGEST DAY" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding BiggestDayText}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="The single day with the most listening time."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="PEAK LISTENING" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding PeakHourText}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Your most active hour and day of the week."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="ACTIVE DAYS" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding ActiveDaysText}" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="Days with at least one counted play."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="AVERAGE PER ACTIVE DAY" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding AvgPerDayText}" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="Listening time averaged over active days."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="LISTENING SESSIONS" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding SessionsText}" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="Runs of plays separated by breaks of 30+ minutes."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="AVERAGE SESSION" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding AvgSessionText}" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="Listening time in a typical session."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="LONGEST SESSION" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding LongestSessionText}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Your single biggest uninterrupted listening stretch."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="WEEKDAYS VS WEEKENDS" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding WeekSplitText}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="How your listening splits across the week."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="FAVORITE TIME OF DAY" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding TimeOfDayText}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="The six-hour window you listen in most."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="SKIP RATE" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding SkipRateText}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Plays Spotify flagged as skipped (short plays included)."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Columns="3" Margin="0,6,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="SHUFFLE RATE" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding ShuffleRateText}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Plays that started in shuffle mode."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="OFFLINE LISTENING" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding OfflineRateText}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Plays from downloads, with no connection."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="TOP DEVICE" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding TopDeviceText}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Where most of your listening happens."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}" Height="440">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Why Plays Ended (short plays included)"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                    <lvc:PieChart Series="{Binding ReasonEndSeries}"
                                                  Background="Transparent"
                                                  LegendPosition="Right" LegendTextSize="12" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Height="400">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Listening by Device"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                    <lvc:PieChart Series="{Binding PlatformSeries}"
                                                  Background="Transparent"
                                                  LegendPosition="Right" LegendTextSize="12" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Height="400">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Listening by Country"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                    <lvc:PieChart Series="{Binding CountrySeries}"
                                                  Background="Transparent"
                                                  LegendPosition="Right" LegendTextSize="12" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Height="560">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Most Skipped Tracks (top 15)"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                    <lvc:CartesianChart Series="{Binding SkippedSeries}"
                                                        Background="Transparent"
                                                        TooltipPosition="Hidden"
                                                        XAxes="{Binding SkippedX}" YAxes="{Binding SkippedY}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
