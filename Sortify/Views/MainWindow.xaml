<views:ThemedWindow x:Class="Sortify.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:Sortify.ViewModels"
        xmlns:views="clr-namespace:Sortify.Views"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="Sortify" Height="900" Width="1500" MinHeight="620" MinWidth="900"
        TitleBarBackground="{DynamicResource PanelBrush}" ShowTitle="False" TitleBarHeight="48"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen" Opacity="0"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnFileDragOver">

    <Window.Resources>
        <!-- Chart cards carry a menu for lifting the chart out as an image. Declared as a
             resource rather than inline in the style setter: WPF cannot wire event handlers
             to elements built inside a Setter.Value. One shared instance is fine - the
             handlers read PlacementTarget, which is set to the card as the menu opens. -->
        <ContextMenu x:Key="ChartMenu" Opened="OnChartMenuOpened">
            <MenuItem Header="Show the numbers..." Tag="numbers" Click="OnShowChartNumbers" InputGestureText="Enter" />
            <Separator />
            <MenuItem Header="Copy chart as image" Click="OnCopyChartImage" />
            <MenuItem Header="Save chart as image..." Click="OnSaveChartImage" />
        </ContextMenu>

        <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="ContextMenu" Value="{StaticResource ChartMenu}" />
        </Style>

        <!-- One day of the listening calendar, shaded by its level of listening. -->
        <Style x:Key="CalendarDayButton" TargetType="Button">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="0,0,3,3" />
            <Setter Property="Focusable" Value="{Binding IsInYear}" />
            <Setter Property="ToolTip" Value="{Binding Description}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border Margin="-2" CornerRadius="3" BorderThickness="2"
                                            BorderBrush="{DynamicResource AccentBrush}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cell" CornerRadius="2" Background="{DynamicResource CalendarLevel0Brush}"
                                BorderBrush="{DynamicResource TextBrush}" BorderThickness="0" />
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="1">
                                <Setter TargetName="cell" Property="Background" Value="{DynamicResource CalendarLevel1Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="2">
                                <Setter TargetName="cell" Property="Background" Value="{DynamicResource CalendarLevel2Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="3">
                                <Setter TargetName="cell" Property="Background" Value="{DynamicResource CalendarLevel3Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="4">
                                <Setter TargetName="cell" Property="Background" Value="{DynamicResource CalendarLevel4Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInYear}" Value="False">
                                <Setter TargetName="cell" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cell" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasListening}" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Back and forward through filter changes, sized to sit in the chip row. -->
        <Style x:Key="FilterHistoryButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>

        <!-- A movement or change on the Compare tab, coloured by which way it went. -->
        <Style x:Key="TrendText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Trend}" Value="Up">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Trend}" Value="Down">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Trend}" Value="New">
                    <Setter Property="Foreground" Value="{DynamicResource Accent2TextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One row of an Overview top-five list. -->
        <DataTemplate x:Key="RankedRow">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Rank}" FontWeight="Bold" FontSize="13"
                           Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" />
                    <TextBlock Text="{Binding Secondary}" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Secondary, Converter={StaticResource TextToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Time}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding PlaysText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding RunAnalysisCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="O" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Modifiers="Control" Key="E" Command="{Binding ExportTxtCommand}" />
        <KeyBinding Modifiers="Control" Key="M" Command="{Binding ExportMarkdownCommand}" />
        <KeyBinding Modifiers="Control" Key="J" Command="{Binding ExportJsonCommand}" />
        <KeyBinding Modifiers="Control" Key="B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding ToggleThemeCommand}" />
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding Filters.ResetCommand}" />
        <!-- A text box that can undo its own typing takes Ctrl+Z first. -->
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding Filters.UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding Filters.RedoCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding Filters.RedoCommand}" />
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding Filters.UndoCommand}" />
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding Filters.RedoCommand}" />
        <KeyBinding Key="BrowserBack" Command="{Binding Filters.UndoCommand}" />
        <KeyBinding Key="BrowserForward" Command="{Binding Filters.RedoCommand}" />
    </Window.InputBindings>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- ======================== Toolbar, in the title bar ======================== -->
    <!-- One bar, like Claude Code's: the buttons are clickable, while the gaps, the logo,
         the name and the progress bar still drag the window (IsHitTestVisible="False" lets
         a click fall through to the bar behind). -->
    <views:ThemedWindow.TitleBarContent>
        <DockPanel LastChildFill="False" Margin="14,0,8,0" VerticalAlignment="Center">
            <Image Source="{StaticResource SortifyLogo}" Width="30" Height="30" Margin="0,0,8,0"
                   VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBlock Text="Sortify" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0"
                       IsHitTestVisible="False" />

            <Button Content="Open Folder" Style="{StaticResource AccentButton}"
                    ToolTip="Pick the extracted export folder; history files are found automatically (Ctrl+Shift+O)"
                    Command="{Binding OpenFolderCommand}" />
            <Button Content="Open Files"
                    ToolTip="Pick the export ZIP Spotify sent, or individual history JSON files (Ctrl+O)"
                    Command="{Binding RunAnalysisCommand}" />
            <!-- U+25BE, which the UI font has; the Segoe MDL2 chevron would be tofu here. -->
            <Button Content="Recent  &#x25BE;" Click="OnRecentClick"
                    AutomationProperties.Name="Recent exports"
                    ToolTip="Export folders and ZIPs you opened before" />

            <Button Content="Export  &#x25BE;" Click="OnDropdownClick"
                    AutomationProperties.Name="Export"
                    ToolTip="Save your results in another format">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Summary as text..." InputGestureText="Ctrl+E"
                                  Command="{Binding ExportTxtCommand}" />
                        <MenuItem Header="Report as Markdown..." InputGestureText="Ctrl+M"
                                  Command="{Binding ExportMarkdownCommand}" />
                        <MenuItem Header="Everything as JSON..." InputGestureText="Ctrl+J"
                                  Command="{Binding ExportJsonCommand}" />
                        <Separator />
                        <MenuItem Header="Tracks as CSV..." Command="{Binding ExportTracksCsvCommand}" />
                        <MenuItem Header="Artists as CSV..." Command="{Binding ExportArtistsCsvCommand}" />
                        <MenuItem Header="Albums as CSV..." Command="{Binding ExportAlbumsCsvCommand}" />
                        <MenuItem Header="Years as CSV..." Command="{Binding ExportYearsCsvCommand}" />
                        <MenuItem Header="Shows as CSV..." Command="{Binding ExportShowsCsvCommand}" />
                        <Separator />
                        <MenuItem Header="Every play as CSV..." Command="{Binding ExportPlaysCsvCommand}" />
                        <Separator />
                        <MenuItem Header="Summary card image..." Click="OnSummaryCard"
                                  IsEnabled="{Binding CanMakeSummaryCard}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- Right-hand icon cluster -->
            <!-- Glyph-only buttons: without a name a screen reader announces the raw
                 private-use character. -->
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    Content="&#xE713;" Click="OnOpenSettings" Margin="0"
                    AutomationProperties.Name="Settings"
                    ToolTip="Settings" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    Content="{Binding ThemeGlyph}" Command="{Binding ToggleThemeCommand}"
                    AutomationProperties.Name="{Binding ThemeTooltip}"
                    ToolTip="{Binding ThemeTooltip}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    Content="&#xE72C;" Command="{Binding ReloadCommand}"
                    AutomationProperties.Name="Reload from disk"
                    ToolTip="Re-read the files from disk, ignoring the cache (F5)" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    Content="&#xE700;" Command="{Binding ToggleSidebarCommand}"
                    AutomationProperties.Name="Show or hide filters"
                    ToolTip="Show or hide the filters (Ctrl+B)" />

            <ProgressBar DockPanel.Dock="Right" Width="140" Height="6"
                         Margin="0,0,10,0" VerticalAlignment="Center"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                         IsHitTestVisible="False" />
        </DockPanel>
    </views:ThemedWindow.TitleBarContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Rule under the title bar, which holds the toolbar. -->
        <Border Grid.Row="0" Height="1" Background="{DynamicResource BorderBrush}" />

        <StackPanel Grid.Row="1">
            <!-- ======================== Sample history notice ====================== -->
            <Border Background="{DynamicResource PanelBrush2}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="14,7"
                    Visibility="{Binding IsSample, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Open your export" Style="{StaticResource AccentButton}"
                            Padding="12,4" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding RunAnalysisCommand}"
                            ToolTip="Pick the export ZIP Spotify sent, or its JSON files (Ctrl+O)" />
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                               Text="This is a made-up sample history: every artist, track and play in it is invented. Open your own export, or drop it on this window, to see yours." />
                </DockPanel>
            </Border>

            <!-- ========================= Active filter chips ======================= -->
            <Border Background="{DynamicResource BgBrush}" Padding="14,8,14,2"
                    Visibility="{Binding ShowFilterBar, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,4">
                        <Button Style="{StaticResource FilterHistoryButton}" Content="&#xE72B;"
                                Command="{Binding Filters.UndoCommand}"
                                AutomationProperties.Name="Undo the last filter change"
                                ToolTip="Undo the last filter change (Ctrl+Z or Alt+Left)" />
                        <Button Style="{StaticResource FilterHistoryButton}" Content="&#xE72A;"
                                Command="{Binding Filters.RedoCommand}"
                                AutomationProperties.Name="Redo the filter change"
                                ToolTip="Redo the filter change you undid (Ctrl+Y or Alt+Right)" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Filtered by" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               FontWeight="SemiBold" Margin="0,0,10,4"
                               Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}" />
                    <TextBlock DockPanel.Dock="Left" Text="No filters, every play counts" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,10,4"
                               Visibility="{Binding HasActiveFilters, Converter={StaticResource NotBoolToVis}}" />
                    <Button DockPanel.Dock="Right" Content="Clear all" Padding="10,3" Margin="6,0,0,4"
                            FontSize="11" VerticalAlignment="Center"
                            Command="{Binding Filters.ResetCommand}"
                            ToolTip="Reset every filter (Ctrl+R)"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding ActiveFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}" Padding="10,1,3,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Text}" FontSize="11" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource ChipCloseButton}" Content="&#xE711;"
                                                Command="{Binding ClearCommand}"
                                                ToolTip="{Binding ClearHint}"
                                                AutomationProperties.Name="{Binding ClearHint}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ============================ Main content =========================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:FilterPanel Grid.Column="0" Width="290" DataContext="{Binding Filters}"
                               Visibility="{Binding DataContext.SidebarVisible,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={StaticResource BoolToVis}}" />

            <Grid Grid.Column="1">
                <!-- Empty state: shown until a history has been loaded. -->
                <Border Visibility="{Binding HasData, Converter={StaticResource NotBoolToVis}}"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Margin="40" MaxWidth="620" MaxHeight="440"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="46"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Drop your Spotify history here" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"
                                   TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="Drag the ZIP Spotify sent you onto this window. No need to unzip it first; the extracted folder or its JSON files work too. Everything is processed on this machine - nothing is uploaded." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Content="Open ZIP or Files" Style="{StaticResource AccentButton}"
                                    Padding="20,9" Command="{Binding RunAnalysisCommand}" />
                            <Button Content="Open Folder" Padding="20,9" Margin="0"
                                    Command="{Binding OpenFolderCommand}" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20,0,0"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="Don't have it yet? Request your extended streaming history from Spotify's privacy page; it usually arrives within a few days." />
                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" FontSize="12">
                            <Hyperlink Command="{Binding OpenSampleCommand}"
                                       ToolTip="Open two years of invented listening to see what Sortify shows">Explore a sample history while you wait</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TabControl x:Name="Tabs" Margin="6,8,6,0" SelectionChanged="OnTabSelectionChanged"
                            Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                    <!-- ============================ OVERVIEW ============================ -->
                    <TabItem Header="Overview">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel SizeChanged="OnOverviewSizeChanged">
                                <Button HorizontalAlignment="Right" Margin="0,8,6,0" Click="OnSummaryCard"
                                        Content="{Binding SummaryCardText}"
                                        IsEnabled="{Binding CanMakeSummaryCard}"
                                        AutomationProperties.Name="{Binding SummaryCardText}"
                                        ToolTip="A 1080 by 1350 image of your listening to save or share. It covers the dates set in the sidebar, or your whole history when none are set." />
                                <UniformGrid x:Name="OverviewFigures" Columns="5" Margin="0,6,0,0">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL TIME" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding TotalTimeText}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL PLAYS" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding TotalPlaysText}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="UNIQUE ARTISTS" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding UniqueArtistsText}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="UNIQUE TRACKS" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding UniqueTracksText}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="DATE RANGE" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding DateRangeText}" FontSize="12" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Top fives -->
                                <UniformGrid x:Name="OverviewLists" Columns="3">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Top Tracks" Style="{StaticResource SectionHeader}"
                                                       Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding TopTracks}"
                                                          ItemTemplate="{StaticResource RankedRow}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Top Artists" Style="{StaticResource SectionHeader}"
                                                       Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding TopArtists}"
                                                          ItemTemplate="{StaticResource RankedRow}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Top Albums" Style="{StaticResource SectionHeader}"
                                                       Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding TopAlbums}"
                                                          ItemTemplate="{StaticResource RankedRow}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource ChartCard}" Height="520">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Top 25 Artists - Share of Listening Time"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                        <lvc:PieChart Series="{Binding ArtistShareSeries}"
                                                      Background="Transparent"
                                                      AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                      LegendPosition="Bottom" LegendTextSize="12" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource ChartCard}" Height="320">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Listening Over Time"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                        <lvc:CartesianChart Series="{Binding OverTime.Series}"
                                                            Background="Transparent"
                                                            AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                            XAxes="{Binding OverTime.XAxes}" YAxes="{Binding OverTime.YAxes}"
                                                            TooltipPosition="Top" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================== TRACKS ============================= -->
                    <TabItem Header="Tracks">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="460" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource ChartCard}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource SectionHeader}"
                                                   Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Run Text="Top Tracks" /><Run Text="   Click a bar for its breakdown" FontWeight="Normal"
                                                                          FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                        </TextBlock>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="{DynamicResource PanelBrush2}" CornerRadius="8" Padding="3"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="TracksTimeToggle" Content="By Time"
                                                             GroupName="TracksMetric" IsChecked="True"
                                                             Style="{StaticResource SegmentToggle}" />
                                                <RadioButton x:Name="TracksCountToggle" Content="By Plays"
                                                             GroupName="TracksMetric"
                                                             Background="{DynamicResource Accent2Brush}"
                                                             Style="{StaticResource SegmentToggle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      ScrollChanged="OnTracksScrollChanged"
                                                      Visibility="{Binding IsChecked, ElementName=TracksTimeToggle, Converter={StaticResource BoolToVis}}">
                                            <lvc:CartesianChart Series="{Binding TracksByTime.Series}" Tag="{Binding TracksByTime}" Cursor="Hand" DataPointerDown="OnChartBarClick" FindingStrategy="CompareOnlyYTakeClosest"
                                                                Background="Transparent" Height="{Binding TracksChartHeight}"
                                                                TooltipPosition="Hidden"
                                                                AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                                XAxes="{Binding TracksByTime.XAxes}" YAxes="{Binding TracksByTime.YAxes}" />
                                        </ScrollViewer>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      ScrollChanged="OnTracksScrollChanged"
                                                      Visibility="{Binding IsChecked, ElementName=TracksCountToggle, Converter={StaticResource BoolToVis}}">
                                            <lvc:CartesianChart Series="{Binding TracksByCount.Series}" Tag="{Binding TracksByCount}" Cursor="Hand" DataPointerDown="OnChartBarClick" FindingStrategy="CompareOnlyYTakeClosest"
                                                                Background="Transparent" Height="{Binding TracksChartHeight}"
                                                                TooltipPosition="Hidden"
                                                                AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                                XAxes="{Binding TracksByCount.XAxes}" YAxes="{Binding TracksByCount.YAxes}" />
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,8">
                                        <TextBox x:Name="TrackQuickFilter" DockPanel.Dock="Right" Width="240"
                                                 AutomationProperties.Name="Filter track rows"
                                                 Text="{Binding TrackQuickFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                                 ToolTip="Narrow the rows below (Ctrl+F)" />
                                        <TextBlock Text="Filter rows" VerticalAlignment="Center" DockPanel.Dock="Right"
                                                   Margin="0,0,8,0" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <Button DockPanel.Dock="Right" Content="Copy as links  &#x25BE;" Click="OnDropdownClick"
                                                Padding="10,5" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center"
                                                AutomationProperties.Name="Copy tracks as Spotify links"
                                                ToolTip="Copy rows as Spotify links, to paste into a playlist in the Spotify desktop app">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Top 25 rows" Tag="25" Click="OnCopyTopTrackLinks" />
                                                    <MenuItem Header="Top 50 rows" Tag="50" Click="OnCopyTopTrackLinks" />
                                                    <MenuItem Header="Top 100 rows" Tag="100" Click="OnCopyTopTrackLinks" />
                                                    <Separator />
                                                    <MenuItem Header="Selected rows" Click="OnCopyLinksFromTracks" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <TextBlock Text="Double-click a row, or select it and press Enter, for the full breakdown. Ctrl- or Shift-click to pick several."
                                                   VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </DockPanel>
                                    <Grid>
                                    <DataGrid x:Name="TracksGrid" ItemsSource="{Binding Tracks}"
                                              AutomationProperties.Name="Tracks"
                                              PreviewMouseRightButtonDown="OnGridRightClick"
                                              ContextMenuOpening="OnGridMenuOpening"
                                              MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Tag="Copy track|Copy {0} tracks" Click="OnCopyTrackFromTracks" />
                                                <MenuItem Tag="Copy artist|Copy their artists" Click="OnCopyArtistFromTracks" />
                                                <MenuItem Tag="Copy Spotify link|Copy {0} Spotify links" Click="OnCopyLinksFromTracks" />
                                                <Separator />
                                                <MenuItem Tag="Show only this artist|Show only their artists" Click="OnFocusArtistFromTracks" />
                                                <MenuItem Tag="Exclude this track|Exclude these {0} tracks" Click="OnExcludeTrackFromTracks" />
                                                <MenuItem Tag="Exclude this artist|Exclude their artists" Click="OnExcludeArtistFromTracks" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Track" Binding="{Binding Track}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Time"
                                                                Binding="{Binding TotalTime, Converter={StaticResource HhMmSs}}"
                                                                Width="95" MinWidth="95" SortMemberPath="TotalMsPlayed" />
                                            <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}"
                                                                Width="75" MinWidth="75" SortMemberPath="TotalMsPlayed" />
                                            <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount, StringFormat=N0}" Width="75" MinWidth="75" />
                                            <DataGridTextColumn Binding="{Binding SkipRate, StringFormat={}{0:0.#}%}" Width="80" MinWidth="80">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="Skip %"
                                                               ToolTip="Share of this track's plays you skipped. Short plays count here, as they do in the skip rate on the Insights tab." />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="First Played"
                                                                Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd HH:mm}"
                                                                Width="140" MinWidth="140" />
                                            <DataGridTextColumn Header="Last Played"
                                                                Binding="{Binding LastPlayed, StringFormat=yyyy-MM-dd HH:mm}"
                                                                Width="140" MinWidth="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Style="{StaticResource EmptyRows}"
                                               Visibility="{Binding Tracks, Converter={StaticResource EmptyToVis}}"
                                               Text="No tracks to show. Try clearing the row filter, or widening the filters in the sidebar." />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ============================== ARTISTS ============================ -->
                    <TabItem Header="Artists">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="460" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource ChartCard}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource SectionHeader}"
                                                   Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Run Text="Top Artists" /><Run Text="   Click a bar for its breakdown" FontWeight="Normal"
                                                                           FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                        </TextBlock>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="{DynamicResource PanelBrush2}" CornerRadius="8" Padding="3"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ArtistsTimeToggle" Content="By Time"
                                                             GroupName="ArtistsMetric" IsChecked="True"
                                                             Style="{StaticResource SegmentToggle}" />
                                                <RadioButton x:Name="ArtistsCountToggle" Content="By Plays"
                                                             GroupName="ArtistsMetric"
                                                             Background="{DynamicResource Accent2Brush}"
                                                             Style="{StaticResource SegmentToggle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      ScrollChanged="OnArtistsScrollChanged"
                                                      Visibility="{Binding IsChecked, ElementName=ArtistsTimeToggle, Converter={StaticResource BoolToVis}}">
                                            <lvc:CartesianChart Series="{Binding ArtistsByTime.Series}" Tag="{Binding ArtistsByTime}" Cursor="Hand" DataPointerDown="OnChartBarClick" FindingStrategy="CompareOnlyYTakeClosest"
                                                                Background="Transparent" Height="{Binding ArtistsChartHeight}"
                                                                TooltipPosition="Hidden"
                                                                AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                                XAxes="{Binding ArtistsByTime.XAxes}" YAxes="{Binding ArtistsByTime.YAxes}" />
                                        </ScrollViewer>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      ScrollChanged="OnArtistsScrollChanged"
                                                      Visibility="{Binding IsChecked, ElementName=ArtistsCountToggle, Converter={StaticResource BoolToVis}}">
                                            <lvc:CartesianChart Series="{Binding ArtistsByCount.Series}" Tag="{Binding ArtistsByCount}" Cursor="Hand" DataPointerDown="OnChartBarClick" FindingStrategy="CompareOnlyYTakeClosest"
                                                                Background="Transparent" Height="{Binding ArtistsChartHeight}"
                                                                TooltipPosition="Hidden"
                                                                AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                                XAxes="{Binding ArtistsByCount.XAxes}" YAxes="{Binding ArtistsByCount.YAxes}" />
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,8">
                                        <TextBox x:Name="ArtistQuickFilter" DockPanel.Dock="Right" Width="240"
                                                 AutomationProperties.Name="Filter artist rows"
                                                 Text="{Binding ArtistQuickFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                                 ToolTip="Narrow the rows below (Ctrl+F)" />
                                        <TextBlock Text="Filter rows" VerticalAlignment="Center" DockPanel.Dock="Right"
                                                   Margin="0,0,8,0" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="Double-click a row, or select it and press Enter, for the full breakdown"
                                                   VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </DockPanel>
                                    <Grid>
                                    <DataGrid x:Name="ArtistsGrid" ItemsSource="{Binding Artists}"
                                              AutomationProperties.Name="Artists"
                                              PreviewMouseRightButtonDown="OnGridRightClick"
                                              ContextMenuOpening="OnGridMenuOpening"
                                              MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Tag="Copy artist|Copy {0} artists" Click="OnCopyArtistFromArtists" />
                                                <Separator />
                                                <MenuItem Tag="Show only this artist|Show only these {0} artists" Click="OnFocusArtistFromArtists" />
                                                <MenuItem Tag="Exclude this artist|Exclude these {0} artists" Click="OnExcludeArtistFromArtists" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Time"
                                                                Binding="{Binding TotalTime, Converter={StaticResource HhMmSs}}"
                                                                Width="95" MinWidth="95" SortMemberPath="TotalMsPlayed" />
                                            <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}"
                                                                Width="75" MinWidth="75" SortMemberPath="TotalMsPlayed" />
                                            <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount, StringFormat=N0}" Width="75" MinWidth="75" />
                                            <DataGridTextColumn Binding="{Binding TrackCount, StringFormat=N0}" Width="80" MinWidth="80">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="Tracks" ToolTip="How many different tracks of theirs you played" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding MonthCount, StringFormat=N0}" Width="85" MinWidth="85">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="Months"
                                                               ToolTip="Calendar months with at least one play: how long they've stayed in your rotation" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="First Track" Binding="{Binding FirstTrack}" Width="*" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="First Played"
                                                                Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd HH:mm}"
                                                                Width="140" MinWidth="140" />
                                            <DataGridTextColumn Header="Last Played"
                                                                Binding="{Binding LastPlayed, StringFormat=yyyy-MM-dd HH:mm}"
                                                                Width="140" MinWidth="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Style="{StaticResource EmptyRows}"
                                               Visibility="{Binding Artists, Converter={StaticResource EmptyToVis}}"
                                               Text="No artists to show. Try clearing the row filter, or widening the filters in the sidebar." />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ============================== ALBUMS ============================= -->
                    <TabItem Header="Albums">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="460" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource ChartCard}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource SectionHeader}"
                                                   Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Run Text="Top Albums" /><Run Text="   Click a bar for its breakdown" FontWeight="Normal"
                                                                          FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                        </TextBlock>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="{DynamicResource PanelBrush2}" CornerRadius="8" Padding="3"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="AlbumsTimeToggle" Content="By Time"
                                                             GroupName="AlbumsMetric" IsChecked="True"
                                                             Style="{StaticResource SegmentToggle}" />
                                                <RadioButton x:Name="AlbumsCountToggle" Content="By Plays"
                                                             GroupName="AlbumsMetric"
                                                             Background="{DynamicResource Accent2Brush}"
                                                             Style="{StaticResource SegmentToggle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      ScrollChanged="OnAlbumsScrollChanged"
                                                      Visibility="{Binding IsChecked, ElementName=AlbumsTimeToggle, Converter={StaticResource BoolToVis}}">
                                            <lvc:CartesianChart Series="{Binding AlbumsByTime.Series}" Tag="{Binding AlbumsByTime}" Cursor="Hand" DataPointerDown="OnChartBarClick" FindingStrategy="CompareOnlyYTakeClosest"
                                                                Background="Transparent" Height="{Binding AlbumsChartHeight}"
                                                                TooltipPosition="Hidden"
                                                                AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                                XAxes="{Binding AlbumsByTime.XAxes}" YAxes="{Binding AlbumsByTime.YAxes}" />
                                        </ScrollViewer>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      ScrollChanged="OnAlbumsScrollChanged"
                                                      Visibility="{Binding IsChecked, ElementName=AlbumsCountToggle, Converter={StaticResource BoolToVis}}">
                                            <lvc:CartesianChart Series="{Binding AlbumsByCount.Series}" Tag="{Binding AlbumsByCount}" Cursor="Hand" DataPointerDown="OnChartBarClick" FindingStrategy="CompareOnlyYTakeClosest"
                                                                Background="Transparent" Height="{Binding AlbumsChartHeight}"
                                                                TooltipPosition="Hidden"
                                                                AnimationsSpeed="0:0:0" EasingFunction="{x:Null}"
                                                                XAxes="{Binding AlbumsByCount.XAxes}" YAxes="{Binding AlbumsByCount.YAxes}" />
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,8">
                                        <TextBox x:Name="AlbumQuickFilter" DockPanel.Dock="Right" Width="240"
                                                 AutomationProperties.Name="Filter album rows"
                                                 Text="{Binding AlbumQuickFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                                 ToolTip="Narrow the rows below (Ctrl+F)" />
                                        <TextBlock Text="Filter rows" VerticalAlignment="Center" DockPanel.Dock="Right"
                                                   Margin="0,0,8,0" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="Double-click a row, or select it and press Enter, for the full breakdown"
                                                   VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </DockPanel>
                                    <Grid>
                                    <DataGrid x:Name="AlbumsGrid" ItemsSource="{Binding Albums}"
                                              AutomationProperties.Name="Albums"
                                              PreviewMouseRightButtonDown="OnGridRightClick"
                                              ContextMenuOpening="OnGridMenuOpening"
                                              MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Tag="Copy album|Copy {0} albums" Click="OnCopyAlbumFromAlbums" />
                                                <MenuItem Tag="Copy artist|Copy their artists" Click="OnCopyArtistFromAlbums" />
                                                <Separator />
                                                <MenuItem Tag="Show only this artist|Show only their artists" Click="OnFocusArtistFromAlbums" />
                                                <MenuItem Tag="Exclude this artist|Exclude their artists" Click="OnExcludeArtistFromAlbums" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Time"
                                                                Binding="{Binding TotalTime, Converter={StaticResource HhMmSs}}"
                                                                Width="95" MinWidth="95" SortMemberPath="TotalMsPlayed" />
                                            <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}"
                                                                Width="75" MinWidth="75" SortMemberPath="TotalMsPlayed" />
                                            <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount, StringFormat=N0}" Width="75" MinWidth="75" />
                                            <DataGridTextColumn Binding="{Binding TrackCount, StringFormat=N0}" Width="80" MinWidth="80">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="Tracks" ToolTip="How many different tracks of this album you played" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="First Played"
                                                                Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd HH:mm}"
                                                                Width="140" MinWidth="140" />
                                            <DataGridTextColumn Header="Last Played"
                                                                Binding="{Binding LastPlayed, StringFormat=yyyy-MM-dd HH:mm}"
                                                                Width="140" MinWidth="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Style="{StaticResource EmptyRows}"
                                               Visibility="{Binding Albums, Converter={StaticResource EmptyToVis}}"
                                               Text="No albums to show. Try clearing the row filter, or widening the filters in the sidebar." />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- =============================== YEARS ============================= -->
                    <TabItem Header="Years">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource ChartCard}" Height="350">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <TextBlock Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left">
                                                <Run Text="Listening Time per Year" /><Run Text="   Click a year for its breakdown" FontWeight="Normal"
                                                                                           FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                            </TextBlock>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="{DynamicResource PanelBrush2}" CornerRadius="8" Padding="3"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="Total" GroupName="YearsView" IsChecked="True"
                                                                 Style="{StaticResource SegmentToggle}" />
                                                    <RadioButton Content="By year found" GroupName="YearsView"
                                                                 IsChecked="{Binding ShowCohorts}"
                                                                 ToolTip="Split each year by when you first heard its music"
                                                                 Style="{StaticResource SegmentToggle}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding CohortText}" FontSize="12" Margin="0,0,0,6"
                                                   TextWrapping="Wrap" Visibility="{Binding ShowCohorts, Converter={StaticResource BoolToVis}}" />
                                        <Grid>
                                            <lvc:CartesianChart Series="{Binding ByYear.Series}" Tag="{Binding ByYear}" Cursor="Hand" DataPointerDown="OnChartBarClick" FindingStrategy="CompareOnlyXTakeClosest"
                                                                Background="Transparent"
                                                                AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                                XAxes="{Binding ByYear.XAxes}" YAxes="{Binding ByYear.YAxes}"
                                                                Visibility="{Binding ShowCohorts, Converter={StaticResource NotBoolToVis}}" />
                                            <lvc:CartesianChart Series="{Binding CohortChart.Series}" Tag="{Binding CohortChart}" Cursor="Hand" DataPointerDown="OnChartBarClick" FindingStrategy="CompareOnlyXTakeClosest"
                                                                Background="Transparent"
                                                                AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                                XAxes="{Binding CohortChart.XAxes}" YAxes="{Binding CohortChart.YAxes}"
                                                                LegendPosition="Right" LegendTextSize="12" TooltipPosition="Top"
                                                                Visibility="{Binding ShowCohorts, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="Double-click a year, or select it and press Enter, for its own breakdown. Right-click it to filter everything to that year or make a shareable year-in-review image." />
                                        <Grid>
                                        <DataGrid x:Name="YearsGrid" ItemsSource="{Binding Years}"
                                                  AutomationProperties.Name="Years" MinHeight="80"
                                                  PreviewMouseWheel="OnPassWheelToPage"
                                                  PreviewMouseRightButtonDown="OnGridRightClick"
                                                  MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open this year's breakdown" Click="OnOpenYearDetail"
                                                              InputGestureText="Enter" />
                                                    <MenuItem Header="Filter everything to this year" Click="OnFilterToYear" />
                                                    <Separator />
                                                    <MenuItem Header="Make a year-in-review image..." Click="OnYearReview" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="70" MinWidth="70" />
                                                <DataGridTextColumn Header="Time"
                                                                    Binding="{Binding TotalTime, Converter={StaticResource HhMmSs}}"
                                                                    Width="95" MinWidth="95" SortMemberPath="TotalMsPlayed" />
                                                <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N1}"
                                                                    Width="75" MinWidth="75" SortMemberPath="TotalMsPlayed" />
                                                <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount, StringFormat=N0}" Width="75" MinWidth="75" />
                                                <DataGridTextColumn Header="Unique Artists" Binding="{Binding UniqueArtists, StringFormat=N0}" Width="120" MinWidth="120" />
                                                <DataGridTextColumn Header="Unique Tracks" Binding="{Binding UniqueTracks, StringFormat=N0}" Width="120" MinWidth="120" />
                                                <DataGridTextColumn Header="Top Artist" Binding="{Binding TopArtist}" Width="*" MinWidth="130" ElementStyle="{StaticResource TrimmedCell}" />
                                                <DataGridTextColumn Header="Top Track" Binding="{Binding TopTrack}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Style="{StaticResource EmptyRows}"
                                                   Visibility="{Binding Years, Converter={StaticResource EmptyToVis}}"
                                                   Text="No dated plays match the current filters." />
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource ChartCard}" Height="430">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Margin="0,0,0,2">
                                            <Run Text="Rank History" /><Run Text="   Click a point for the artist's breakdown" FontWeight="Normal"
                                                                           FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                        </TextBlock>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{Binding RankHint}" />
                                        <Grid>
                                            <lvc:CartesianChart Series="{Binding RankChart.Series}" Tag="{Binding RankChart}" Cursor="Hand"
                                                                DataPointerDown="OnRankPointClick" FindingStrategy="CompareAllTakeClosest"
                                                                Background="Transparent"
                                                                AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                                XAxes="{Binding RankChart.XAxes}" YAxes="{Binding RankChart.YAxes}"
                                                                LegendPosition="Right" LegendTextSize="12" TooltipPosition="Top"
                                                                Visibility="{Binding HasRankHistory, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Style="{StaticResource EmptyRows}" Margin="0,40,0,0"
                                                       Text="Rank history needs at least two years of listening under the current filters."
                                                       Visibility="{Binding HasRankHistory, Converter={StaticResource NotBoolToVis}}" />
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================= PODCASTS ============================ -->
                    <TabItem Header="Podcasts">
                        <Grid>
                            <!-- Nothing to show until an export actually contains shows. -->
                            <TextBlock Text="No podcasts or audiobooks were found in this history."
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasPodcastData, Converter={StaticResource NotBoolToVis}}" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasPodcastData, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <UniformGrid Columns="4" Margin="0,6,0,0">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="TIME LISTENED" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{Binding Insights.PodcastTime}" Style="{StaticResource StatValueSmall}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="PLAYS" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{Binding Insights.PodcastPlays}" Style="{StaticResource StatValueSmall}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="SHOWS" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{Binding Insights.Shows}" Style="{StaticResource StatValueSmall}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="EPISODES" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{Binding Insights.Episodes}" Style="{StaticResource StatValueSmall}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Style="{StaticResource ChartCard}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Margin="0,0,0,8">
                                                <Run Text="Top Shows and Audiobooks (top 20)" /><Run Text="   Click a bar for its breakdown"
                                                    FontWeight="Normal" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                            </TextBlock>
                                            <lvc:CartesianChart Series="{Binding ShowsChart.Series}" Tag="{Binding ShowsChart}" Cursor="Hand" DataPointerDown="OnChartBarClick" FindingStrategy="CompareOnlyYTakeClosest"
                                                                Background="Transparent"
                                                                Height="{Binding ShowsChartHeight}"
                                                                TooltipPosition="Hidden"
                                                                AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                                XAxes="{Binding ShowsChart.XAxes}" YAxes="{Binding ShowsChart.YAxes}" />
                                        </DockPanel>
                                    </Border>

                                    <Border Style="{StaticResource ChartCard}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Margin="0,0,0,8">
                                                <Run Text="Top Episodes and Chapters (top 20)" /><Run Text="   Click a bar for its breakdown"
                                                    FontWeight="Normal" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                            </TextBlock>
                                            <lvc:CartesianChart Series="{Binding EpisodesChart.Series}" Tag="{Binding EpisodesChart}" Cursor="Hand" DataPointerDown="OnChartBarClick" FindingStrategy="CompareOnlyYTakeClosest"
                                                                Background="Transparent"
                                                                Height="{Binding EpisodesChartHeight}"
                                                                TooltipPosition="Hidden"
                                                                AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                                XAxes="{Binding EpisodesChart.XAxes}" YAxes="{Binding EpisodesChart.YAxes}" />
                                        </DockPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Height="340">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                                                <TextBox x:Name="ShowQuickFilter" DockPanel.Dock="Right" Width="240"
                                                         AutomationProperties.Name="Filter shows and episodes"
                                                         Text="{Binding ShowQuickFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                                         ToolTip="Narrow the shows and episodes below (Ctrl+F)" />
                                                <TextBlock Text="Shows" Style="{StaticResource SectionHeader}"
                                                           Margin="0" VerticalAlignment="Center" />
                                                <TextBlock Text="Double-click a show or an episode, or select it and press Enter, for its breakdown"
                                                           VerticalAlignment="Center" FontSize="11" Margin="14,0,0,0"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </DockPanel>
                                            <Grid>
                                            <DataGrid x:Name="ShowsGrid" ItemsSource="{Binding Shows}" AutomationProperties.Name="Shows"
                                                      MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Show" Binding="{Binding Show}" Width="2*" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="Auto" />
                                                    <DataGridTextColumn Header="Time"
                                                                        Binding="{Binding TotalTime, Converter={StaticResource HhMmSs}}"
                                                                        Width="Auto" SortMemberPath="TotalMsPlayed" />
                                                    <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount, StringFormat=N0}" Width="Auto" />
                                                    <DataGridTextColumn Header="Episodes" Binding="{Binding EpisodeCount, StringFormat=N0}" Width="Auto" />
                                                    <DataGridTextColumn Header="First Played"
                                                                        Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd}"
                                                                        Width="Auto" />
                                                    <DataGridTextColumn Header="Last Played"
                                                                        Binding="{Binding LastPlayed, StringFormat=yyyy-MM-dd}"
                                                                        Width="Auto" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Style="{StaticResource EmptyRows}"
                                                       Visibility="{Binding Shows, Converter={StaticResource EmptyToVis}}"
                                                       Text="No shows match the filter." />
                                            </Grid>
                                        </DockPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Height="320">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Episodes" Style="{StaticResource SectionHeader}"
                                                       Margin="0,0,0,8" />
                                            <Grid>
                                            <DataGrid x:Name="EpisodesGrid" ItemsSource="{Binding Episodes}" AutomationProperties.Name="Episodes"
                                                      MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Episode" Binding="{Binding Episode}" Width="2*" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="Show" Binding="{Binding Show}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="Time"
                                                                        Binding="{Binding TotalTime, Converter={StaticResource HhMmSs}}"
                                                                        Width="Auto" SortMemberPath="TotalMsPlayed" />
                                                    <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount, StringFormat=N0}" Width="Auto" />
                                                    <DataGridTextColumn Header="First Played"
                                                                        Binding="{Binding FirstPlayed, StringFormat=yyyy-MM-dd}"
                                                                        Width="Auto" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Style="{StaticResource EmptyRows}"
                                                       Visibility="{Binding Episodes, Converter={StaticResource EmptyToVis}}"
                                                       Text="No episodes match the filter." />
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ============================== TRENDS ============================= -->
                    <TabItem Header="Trends">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource ChartCard}" Height="320">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <TextBlock Text="Listening Over Time" Style="{StaticResource SectionHeader}"
                                                       Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="{DynamicResource PanelBrush2}" CornerRadius="8" Padding="3"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="Daily" GroupName="OverTimeGran" IsChecked="True"
                                                                 Tag="Daily" Checked="OnGranularityChecked"
                                                                 Style="{StaticResource SegmentToggle}" />
                                                    <RadioButton Content="Weekly" GroupName="OverTimeGran"
                                                                 Tag="Weekly" Checked="OnGranularityChecked"
                                                                 Style="{StaticResource SegmentToggle}" />
                                                    <RadioButton Content="Monthly" GroupName="OverTimeGran"
                                                                 Tag="Monthly" Checked="OnGranularityChecked"
                                                                 Style="{StaticResource SegmentToggle}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <lvc:CartesianChart Series="{Binding OverTime.Series}"
                                                            Background="Transparent"
                                                            AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                            XAxes="{Binding OverTime.XAxes}" YAxes="{Binding OverTime.YAxes}"
                                                            TooltipPosition="Top" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" DataContext="{Binding Calendar}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                            <TextBlock Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left">
                                                <Run Text="Listening Calendar" /><Run Text="   Click a day for its breakdown" FontWeight="Normal"
                                                    FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                            </TextBlock>
                                            <ItemsControl HorizontalAlignment="Right" ItemsSource="{Binding Years}" Focusable="False"
                                                          AutomationProperties.Name="Years in the calendar">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Year}" Style="{StaticResource QuickRangeButton}" Margin="5,0,0,4"
                                                                Command="{Binding DataContext.ShowYearCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="{Binding Year, StringFormat='Show {0} in the calendar'}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontSize="12" Margin="0,0,0,10"
                                                   TextWrapping="Wrap" />
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Margin="0,10,0,0" Visibility="{Binding HasDays, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Less" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <Border Width="11" Height="11" CornerRadius="2" Margin="0,0,3,0"
                                                    Background="{DynamicResource CalendarLevel0Brush}" />
                                            <Border Width="11" Height="11" CornerRadius="2" Margin="0,0,3,0"
                                                    Background="{DynamicResource CalendarLevel1Brush}" />
                                            <Border Width="11" Height="11" CornerRadius="2" Margin="0,0,3,0"
                                                    Background="{DynamicResource CalendarLevel2Brush}" />
                                            <Border Width="11" Height="11" CornerRadius="2" Margin="0,0,3,0"
                                                    Background="{DynamicResource CalendarLevel3Brush}" />
                                            <Border Width="11" Height="11" CornerRadius="2" Margin="0,0,3,0"
                                                    Background="{DynamicResource CalendarLevel4Brush}" />
                                            <TextBlock Text="More" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>
                                        <!-- Scales down, never up, so a narrow window still shows the whole year. -->
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"
                                                 Visibility="{Binding HasDays, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding MonthLabels}" Height="16"
                                                              Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Text}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding DayLabels}" Margin="0,0,6,0"
                                                              Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="10" Height="16" LineHeight="13"
                                                                       Foreground="{DynamicResource MutedBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Weeks}"
                                                              KeyboardNavigation.TabNavigation="Once"
                                                              KeyboardNavigation.DirectionalNavigation="Contained"
                                                              AutomationProperties.Name="{Binding Year, StringFormat='Listening calendar for {0}'}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource CalendarDayButton}" Click="OnCalendarDayClick" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Viewbox>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource ChartCard}" Height="460" DataContext="{Binding CompareArtists}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <TextBlock Text="Compare Artists" Style="{StaticResource SectionHeader}"
                                                       Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="{DynamicResource PanelBrush2}" CornerRadius="8" Padding="3"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="Monthly" GroupName="CompareGran" IsChecked="True"
                                                                 Tag="Monthly" Checked="OnCompareGranularityChecked"
                                                                 Style="{StaticResource SegmentToggle}" />
                                                    <RadioButton Content="Weekly" GroupName="CompareGran"
                                                                 Tag="Weekly" Checked="OnCompareGranularityChecked"
                                                                 Style="{StaticResource SegmentToggle}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,2,0,4">
                                            <TextBox DockPanel.Dock="Left" Width="220" VerticalAlignment="Center"
                                                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Add an artist to compare"
                                                     ToolTip="Type an artist's name, then pick a match or press Enter for the first one">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <ItemsControl ItemsSource="{Binding Artists}" Margin="10,0,0,0"
                                                          VerticalAlignment="Center" Focusable="False"
                                                          AutomationProperties.Name="Artists being compared">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Chip}" Padding="10,1,3,1" Margin="0,2,6,2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center" />
                                                                <Button Style="{StaticResource ChipCloseButton}" Content="&#xE711;"
                                                                        Command="{Binding DataContext.RemoveCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Take this artist off the chart"
                                                                        AutomationProperties.Name="{Binding StringFormat='Stop comparing {0}'}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Suggestions}"
                                                      Focusable="False" AutomationProperties.Name="Matching artists">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" ContentStringFormat="+  {0}" Style="{StaticResource QuickRangeButton}"
                                                            Command="{Binding DataContext.AddCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding StringFormat='Compare {0}'}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Hint}" Style="{StaticResource Hint}"
                                                   FontSize="11" Margin="0,0,0,4"
                                                   Visibility="{Binding Hint, Converter={StaticResource TextToVis}}" />
                                        <lvc:CartesianChart Series="{Binding Chart.Series}"
                                                            Background="Transparent"
                                                            AnimationsSpeed="{Binding DataContext.ChartAnimationSpeed,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                            XAxes="{Binding Chart.XAxes}"
                                                            YAxes="{Binding Chart.YAxes}"
                                                            LegendPosition="Bottom" LegendTextSize="12"
                                                            TooltipPosition="Top" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource ChartCard}" Height="340">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Margin="0,0,0,6">
                                            <Run Text="Listening Heatmap (day of week vs. hour of day)" /><Run Text="   Click a square to see only that hour of that day"
                                                FontWeight="Normal" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                        </TextBlock>
                                        <lvc:CartesianChart Series="{Binding Heat.Series}" Tag="{Binding Heat}" Cursor="Hand" DataPointerDown="OnHeatClick" FindingStrategy="CompareAllTakeClosest"
                                                            Background="Transparent"
                                                            AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                            XAxes="{Binding Heat.XAxes}" YAxes="{Binding Heat.YAxes}"
                                                            TooltipPosition="Hidden" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource ChartCard}" Height="300">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="New Artists Discovered per Month"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                        <lvc:CartesianChart Series="{Binding Discovery.Series}"
                                                            Background="Transparent"
                                                            AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                            XAxes="{Binding Discovery.XAxes}" YAxes="{Binding Discovery.YAxes}"
                                                            TooltipPosition="Top" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Height="400">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Your #1 Each Month"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding MonthlyLeaderText}"
                                                   FontSize="12" Margin="0,0,0,2" TextWrapping="Wrap" />
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                   Text="The artist and track you listened to longest each month. Double-click a month for its top artist; right-click for its top track." />
                                        <Grid>
                                            <DataGrid x:Name="MonthsGrid" ItemsSource="{Binding Months}"
                                                      AutomationProperties.Name="Top artist and track per month"
                                                      SelectionMode="Single"
                                                      PreviewMouseRightButtonDown="OnGridRightClick"
                                                      MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open the top artist" Click="OnOpenMonthArtist"
                                                                  InputGestureText="Enter" />
                                                        <MenuItem Header="Open the top track" Click="OnOpenMonthTrack" />
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Month" Binding="{Binding Month, StringFormat=yyyy-MM}"
                                                                        Width="Auto" SortMemberPath="Month" />
                                                    <DataGridTextColumn Header="Top Artist" Binding="{Binding TopArtist}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="Hours" Binding="{Binding TopArtistHours, StringFormat=N1}"
                                                                        Width="Auto" SortMemberPath="TopArtistMs" />
                                                    <DataGridTextColumn Header="Top Track" Binding="{Binding TopTrack}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="By" Binding="{Binding TopTrackArtist}" Width="0.7*" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="Hours" Binding="{Binding TopTrackHours, StringFormat=N1}"
                                                                        Width="Auto" SortMemberPath="TopTrackMs" />
                                                    <DataGridTextColumn Header="Month Total"
                                                                        Binding="{Binding TotalTime, Converter={StaticResource HhMmSs}}"
                                                                        Width="Auto" SortMemberPath="TotalMsPlayed" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Style="{StaticResource EmptyRows}"
                                                       Visibility="{Binding Months, Converter={StaticResource EmptyToVis}}"
                                                       Text="No dated plays match the current filters." />
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource ChartCard}" Height="300">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Listening by Hour of Day"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                        <lvc:CartesianChart Series="{Binding ByHour.Series}"
                                                            Background="Transparent"
                                                            AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                            XAxes="{Binding ByHour.XAxes}" YAxes="{Binding ByHour.YAxes}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource ChartCard}" Height="300">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Listening by Day of Week"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                        <lvc:CartesianChart Series="{Binding ByDayOfWeek.Series}"
                                                            Background="Transparent"
                                                            AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                            XAxes="{Binding ByDayOfWeek.XAxes}" YAxes="{Binding ByDayOfWeek.YAxes}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================= INSIGHTS ============================ -->
                    <TabItem Header="Insights">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <UniformGrid Columns="3" Margin="0,6,0,0">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="LONGEST STREAK" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.LongestStreak}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Consecutive days with listening." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="CURRENT STREAK" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.CurrentStreak}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Consecutive days ending on your most recent listening day." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="LONGEST BREAK" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.LongestBreak}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Your longest stretch without playing anything." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="BIGGEST DAY" Style="{StaticResource Caption}" />
                                            <TextBlock Style="{StaticResource StatValueSmall}">
                                                <Hyperlink Click="OnOpenBiggestDay" ToolTip="Open this day's breakdown"><Run Text="{Binding Insights.BiggestDay, Mode=OneWay}" /></Hyperlink>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="The single day with the most listening time. Click it for what you played." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="PEAK LISTENING" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.PeakHour}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="The hour of the week you listen to most." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ACTIVE DAYS" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.ActiveDays}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Days with at least one counted play." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="AVERAGE PER ACTIVE DAY" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.AveragePerDay}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Listening time averaged over active days." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="LISTENING SESSIONS" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.Sessions}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Runs of plays separated by a long enough break (set in Settings)." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="AVERAGE SESSION" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.AverageSession}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Listening time in a typical session." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="LONGEST SESSION" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.LongestSession}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Your single biggest uninterrupted listening stretch." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="WEEKDAYS VS WEEKENDS" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.WeekSplit}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="How your listening splits across the week." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="FAVORITE TIME OF DAY" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.TimeOfDay}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="The six-hour window you listen in most." />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="SKIP RATE" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.SkipRate}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Plays Spotify flagged as skipped (short plays included)." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="COMPLETION RATE" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.CompletionRate}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Plays that ran all the way to the end of the track." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="REPEAT RATE" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.RepeatRate}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="How often you come back to the same track." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="DISCOVERY RATE" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.DiscoveryRate}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Artists you heard for the first time, per month." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="MOST LISTENED ARTIST" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.TopArtistShare}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Share of your listening time going to one artist." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="SHUFFLE RATE" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.ShuffleRate}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Plays that started in shuffle mode." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="OFFLINE LISTENING" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.OfflineRate}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Plays from downloads, with no connection." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="PRIVATE SESSIONS" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.PrivateSessions}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Plays from private sessions. The sidebar can leave them out." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="TOP DEVICE" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Insights.TopDevice}" Style="{StaticResource StatValueSmall}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Where most of your listening happens." />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Milestones"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                   Text="The plays that mark your history: the first, the ones that reached round numbers of plays and hours, and the first time your top artist came on. Double-click one for that track's breakdown." />
                                        <Grid>
                                            <DataGrid ItemsSource="{Binding Milestones}" AutomationProperties.Name="Milestones"
                                                      SelectionMode="Single" MinHeight="80"
                                                      PreviewMouseWheel="OnPassWheelToPage"
                                                      MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Milestone" Binding="{Binding Label}" Width="1.4*" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="When" Binding="{Binding Date, StringFormat=yyyy-MM-dd HH:mm}"
                                                                        Width="145" SortMemberPath="Date" />
                                                    <DataGridTextColumn Header="Track" Binding="{Binding Track.Track}" Width="1.2*" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="Artist" Binding="{Binding Track.Artist}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Style="{StaticResource EmptyRows}"
                                                       Visibility="{Binding Milestones, Converter={StaticResource EmptyToVis}}"
                                                       Text="No dated plays match the current filters." />
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Height="360">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="Copy tracks as links" Click="OnCopyRepeatLinks"
                                                    Padding="10,5" FontSize="11" Margin="0" VerticalAlignment="Center"
                                                    AutomationProperties.Name="Copy the tracks on repeat as Spotify links"
                                                    ToolTip="Copy every track below as a Spotify link, to paste into a playlist" />
                                            <TextBlock Text="On Repeat" Style="{StaticResource SectionHeader}"
                                                       Margin="0" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                   Text="{Binding OnRepeatHint}" />
                                        <Grid>
                                            <DataGrid x:Name="RepeatGrid" ItemsSource="{Binding OnRepeat}"
                                                      AutomationProperties.Name="Tracks on repeat"
                                                      PreviewMouseRightButtonDown="OnGridRightClick"
                                                      ContextMenuOpening="OnGridMenuOpening"
                                                      MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Tag="Copy Spotify link|Copy {0} Spotify links" Click="OnCopyLinksFromRepeats" />
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Track" Binding="{Binding Track.Track}" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="Artist" Binding="{Binding Track.Artist}" Width="*" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="Plays" Binding="{Binding Plays, StringFormat=N0}" Width="75" MinWidth="75" />
                                                    <DataGridTextColumn Header="From" Binding="{Binding From, StringFormat=yyyy-MM-dd}"
                                                                        SortMemberPath="From" Width="110" MinWidth="110" />
                                                    <DataGridTextColumn Header="To" Binding="{Binding To, StringFormat=yyyy-MM-dd}"
                                                                        SortMemberPath="To" Width="110" MinWidth="110" />
                                                    <DataGridTextColumn Binding="{Binding Track.PlayCount}" Width="95" MinWidth="95">
                                                        <DataGridTextColumn.Header>
                                                            <TextBlock Text="All Plays" ToolTip="Every play of the track under the current filters" />
                                                        </DataGridTextColumn.Header>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Style="{StaticResource EmptyRows}" Text="{Binding OnRepeatEmpty}"
                                                       Visibility="{Binding OnRepeat, Converter={StaticResource EmptyToVis}}" />
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Height="400">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="Copy tracks as links" Click="OnCopyForgottenLinks"
                                                    Padding="10,5" FontSize="11" Margin="0" VerticalAlignment="Center"
                                                    AutomationProperties.Name="Copy the forgotten tracks as Spotify links"
                                                    ToolTip="Copy every track below as a Spotify link, to paste into a playlist and hear them again" />
                                            <TextBlock Text="Forgotten Favorites" Style="{StaticResource SectionHeader}"
                                                       Margin="0" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                   Text="{Binding ForgottenHint}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <DataGrid x:Name="ForgottenTracksGrid" ItemsSource="{Binding ForgottenTracks}"
                                                          AutomationProperties.Name="Forgotten tracks"
                                                          PreviewMouseRightButtonDown="OnGridRightClick"
                                                          ContextMenuOpening="OnGridMenuOpening"
                                                          MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                    <DataGrid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Tag="Copy Spotify link|Copy {0} Spotify links" Click="OnCopyLinksFromGrid" />
                                                        </ContextMenu>
                                                    </DataGrid.ContextMenu>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Track" Binding="{Binding Track}" Width="2*" ElementStyle="{StaticResource TrimmedCell}" />
                                                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                        <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount, StringFormat=N0}" Width="Auto" />
                                                        <DataGridTextColumn Header="Last Played"
                                                                            Binding="{Binding LastPlayed, StringFormat=yyyy-MM-dd}"
                                                                            Width="108" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock Style="{StaticResource EmptyRows}"
                                                           Visibility="{Binding ForgottenTracks, Converter={StaticResource EmptyToVis}}"
                                                           Text="No forgotten tracks: everything you played that often is still in rotation." />
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <DataGrid ItemsSource="{Binding ForgottenArtists}"
                                                          AutomationProperties.Name="Forgotten artists"
                                                          MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                        <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount, StringFormat=N0}" Width="Auto" />
                                                        <DataGridTextColumn Header="Last Played"
                                                                            Binding="{Binding LastPlayed, StringFormat=yyyy-MM-dd}"
                                                                            Width="108" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock Style="{StaticResource EmptyRows}"
                                                           Visibility="{Binding ForgottenArtists, Converter={StaticResource EmptyToVis}}"
                                                           Text="No forgotten artists." />
                                            </Grid>
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource ChartCard}" Height="440">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Why Plays Ended (short plays included)"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                        <lvc:PieChart Series="{Binding ReasonEndSeries}"
                                                      Background="Transparent"
                                                      AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                      LegendPosition="Right" LegendTextSize="12" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource ChartCard}" Height="400">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Listening by Device"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                        <lvc:PieChart Series="{Binding PlatformSeries}"
                                                      Background="Transparent"
                                                      AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                      LegendPosition="Right" LegendTextSize="12" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource ChartCard}" Height="400">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Listening by Country"
                                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                        <lvc:PieChart Series="{Binding CountrySeries}"
                                                      Background="Transparent"
                                                      AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                      LegendPosition="Right" LegendTextSize="12" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource ChartCard}" Height="560">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Margin="0,0,0,8">
                                            <Run Text="Most Skipped Tracks (top 15)" /><Run Text="   Click a bar for the track's breakdown"
                                                FontWeight="Normal" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                        </TextBlock>
                                        <lvc:CartesianChart Series="{Binding Skipped.Series}" Tag="{Binding Skipped}" Cursor="Hand" DataPointerDown="OnChartBarClick" FindingStrategy="CompareOnlyYTakeClosest"
                                                            Background="Transparent"
                                                            TooltipPosition="Hidden"
                                                            AnimationsSpeed="{Binding ChartAnimationSpeed}"
                                                            XAxes="{Binding Skipped.XAxes}" YAxes="{Binding Skipped.YAxes}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================= COMPARE ============================= -->
                    <TabItem x:Name="CompareTab" Header="Compare">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding Compare}" SizeChanged="OnCompareSizeChanged">
                                <Border HorizontalAlignment="Left" Margin="6,8,6,0"
                                        Background="{DynamicResource PanelBrush2}" CornerRadius="8" Padding="3"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Two periods" IsChecked="{Binding IsPeriodsMode}"
                                                     Style="{StaticResource SegmentToggle}"
                                                     ToolTip="Two stretches of your own history side by side" />
                                        <RadioButton Content="You and someone else" IsChecked="{Binding IsPeopleMode}"
                                                     Style="{StaticResource SegmentToggle}"
                                                     ToolTip="Your history next to another person's export" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding IsPeriodsMode, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource Card}" Margin="6,6,6,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Swap A and B" Command="{Binding SwapCommand}"
                                                            Padding="10,5" FontSize="11" />
                                                    <Button Content="Make A the stretch before B" Command="{Binding MatchAToBCommand}"
                                                            Padding="10,5" FontSize="11" Margin="0"
                                                            ToolTip="Set period A to the same number of days, ending the day before B starts" />
                                                </StackPanel>
                                                <TextBlock Text="Compare Two Periods" Style="{StaticResource SectionHeader}"
                                                           Margin="0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                                                       Text="Every other filter in the sidebar applies to both periods. The sidebar's own date range is set aside here." />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding PeriodALabel}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <DatePicker Grid.Column="0" SelectedDate="{Binding StartA}"
                                                                    AutomationProperties.Name="Period A from" ToolTip="Period A starts" />
                                                        <DatePicker Grid.Column="2" SelectedDate="{Binding EndA}"
                                                                    AutomationProperties.Name="Period A to" ToolTip="Period A ends (this day included)" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding RangesA}" Margin="0,8,0,0" Focusable="False"
                                                                  AutomationProperties.Name="Quick ranges for period A">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding Label}" Style="{StaticResource QuickRangeButton}"
                                                                        ToolTip="{Binding Tooltip}" AutomationProperties.HelpText="{Binding Tooltip}"
                                                                        Command="{Binding DataContext.ApplyRangeACommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding PeriodBLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <DatePicker Grid.Column="0" SelectedDate="{Binding StartB}"
                                                                    AutomationProperties.Name="Period B from" ToolTip="Period B starts" />
                                                        <DatePicker Grid.Column="2" SelectedDate="{Binding EndB}"
                                                                    AutomationProperties.Name="Period B to" ToolTip="Period B ends (this day included)" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding RangesB}" Margin="0,8,0,0" Focusable="False"
                                                                  AutomationProperties.Name="Quick ranges for period B">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding Label}" Style="{StaticResource QuickRangeButton}"
                                                                        ToolTip="{Binding Tooltip}" AutomationProperties.HelpText="{Binding Tooltip}"
                                                                        Command="{Binding DataContext.ApplyRangeBCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DangerBrush}" views:LiveRegion.Announce="Polite"
                                                       Visibility="{Binding Message, Converter={StaticResource TextToVis}}" />
                                            <TextBlock Text="Working out both periods..." Style="{StaticResource Hint}" FontSize="11"
                                                       Margin="0,8,0,0"
                                                       Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="At a Glance" Style="{StaticResource SectionHeader}"
                                                       Margin="0,0,0,8" />
                                            <DataGrid ItemsSource="{Binding Metrics}" AutomationProperties.Name="Headline figures for both periods"
                                                      SelectionMode="Single" PreviewMouseWheel="OnPassWheelToPage">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="" Binding="{Binding Metric}" Width="1.4*" MinWidth="185" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="Period A" Binding="{Binding A}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="Period B" Binding="{Binding B}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                    <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="*"
                                                                        ElementStyle="{StaticResource TrendText}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <UniformGrid x:Name="CompareRankings" Columns="2">
                                        <Border Style="{StaticResource Card}" Height="480">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Artists" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                           Text="Ranked by listening time in period B. ▲ climbed since A, ▼ fell, new wasn't played in A, out isn't played in B." />
                                                <DataGrid ItemsSource="{Binding Artists}" AutomationProperties.Name="Artists in both periods"
                                                          MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="#" Binding="{Binding RankB, TargetNullValue=-}" Width="Auto"
                                                                            SortMemberPath="RankB" />
                                                        <DataGridTextColumn Header="Artist" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                        <DataGridTextColumn Header="Hours B" Binding="{Binding HoursB, StringFormat=N1}" Width="Auto"
                                                                            SortMemberPath="MsB" />
                                                        <DataGridTextColumn Header="Hours A" Binding="{Binding HoursA, StringFormat=N1}" Width="Auto"
                                                                            SortMemberPath="MsA" />
                                                        <DataGridTextColumn Header="Move" Binding="{Binding Movement}" Width="Auto"
                                                                            ElementStyle="{StaticResource TrendText}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Height="480">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Tracks" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                           Text="The same for tracks. Double-click a row for its breakdown under the sidebar's filters." />
                                                <DataGrid ItemsSource="{Binding Tracks}" AutomationProperties.Name="Tracks in both periods"
                                                          MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="#" Binding="{Binding RankB, TargetNullValue=-}" Width="Auto"
                                                                            SortMemberPath="RankB" />
                                                        <DataGridTextColumn Header="Track" Binding="{Binding Name}" Width="1.4*" ElementStyle="{StaticResource TrimmedCell}" />
                                                        <DataGridTextColumn Header="Artist" Binding="{Binding Secondary}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                        <DataGridTextColumn Header="Hours B" Binding="{Binding HoursB, StringFormat=N1}" Width="Auto"
                                                                            SortMemberPath="MsB" />
                                                        <DataGridTextColumn Header="Hours A" Binding="{Binding HoursA, StringFormat=N1}" Width="Auto"
                                                                            SortMemberPath="MsA" />
                                                        <DataGridTextColumn Header="Move" Binding="{Binding Movement}" Width="Auto"
                                                                            ElementStyle="{StaticResource TrendText}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </UniformGrid>

                                    <UniformGrid x:Name="CompareNewGone" Columns="2">
                                        <Border Style="{StaticResource Card}" Height="360">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="New in Period B" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                           Text="Artists you listened to for at least an hour in B and not at all in A." />
                                                <Grid>
                                                    <DataGrid ItemsSource="{Binding NewInB}" AutomationProperties.Name="Artists new in period B"
                                                              MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Artist" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                            <DataGridTextColumn Header="Hours in B" Binding="{Binding HoursB, StringFormat=N1}"
                                                                                Width="Auto" SortMemberPath="MsB" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <TextBlock Style="{StaticResource EmptyRows}"
                                                               Visibility="{Binding NewInB, Converter={StaticResource EmptyToVis}}"
                                                               Text="No artist is new in period B." />
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Height="360">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Gone Since Period A" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                           Text="Artists you listened to for at least an hour in A and not at all in B." />
                                                <Grid>
                                                    <DataGrid ItemsSource="{Binding GoneSinceA}" AutomationProperties.Name="Artists gone since period A"
                                                              MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Artist" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                            <DataGridTextColumn Header="Hours in A" Binding="{Binding HoursA, StringFormat=N1}"
                                                                                Width="Auto" SortMemberPath="MsA" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <TextBlock Style="{StaticResource EmptyRows}"
                                                               Visibility="{Binding GoneSinceA, Converter={StaticResource EmptyToVis}}"
                                                               Text="Every artist from period A was played again in B." />
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsPeopleMode, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource Card}" Margin="6,6,6,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding HasOther, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="Open a different export..." Command="{Binding OpenOtherFilesCommand}"
                                                            Padding="10,5" FontSize="11"
                                                            ToolTip="Replace their history with another export ZIP or its JSON files" />
                                                    <Button Content="Close their history" Command="{Binding CloseOtherCommand}"
                                                            Padding="10,5" FontSize="11" Margin="0" />
                                                </StackPanel>
                                                <TextBlock Text="You and Someone Else" Style="{StaticResource SectionHeader}"
                                                           Margin="0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                                                       Text="Open another person's Spotify export to set their listening next to yours. Every filter in the sidebar applies to both of you, dates included. Their history stays in memory until you close it or Sortify, and is never saved." />

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding CanOpenOther, Converter={StaticResource BoolToVis}}">
                                                <Button Content="Open their ZIP or files..." Style="{StaticResource AccentButton}"
                                                        Command="{Binding OpenOtherFilesCommand}"
                                                        ToolTip="The export ZIP Spotify sent them, or the history JSON files inside it" />
                                                <Button Content="Open their folder..." Command="{Binding OpenOtherFolderCommand}"
                                                        ToolTip="The folder their export unpacks to; history files are found automatically" />
                                            </StackPanel>

                                            <DockPanel Visibility="{Binding IsLoadingOther, Converter={StaticResource BoolToVis}}">
                                                <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelOtherCommand}"
                                                        Padding="10,5" FontSize="11" Margin="0" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding OtherStatus}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               views:LiveRegion.Announce="Polite" />
                                                    <ProgressBar Value="{Binding OtherProgress}" Maximum="100" Height="4" Margin="0,6,0,0"
                                                                 IsIndeterminate="{Binding IsOtherProgressUnknown}"
                                                                 AutomationProperties.Name="Reading their history" />
                                                </StackPanel>
                                            </DockPanel>

                                            <TextBlock Text="{Binding OtherSummary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Visibility="{Binding HasOther, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DangerBrush}" views:LiveRegion.Announce="Polite"
                                                       Visibility="{Binding Message, Converter={StaticResource TextToVis}}" />
                                            <TextBlock Text="Comparing your listening with theirs..." Style="{StaticResource Hint}" FontSize="11"
                                                       Margin="0,8,0,0"
                                                       Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Visibility="{Binding HasOther, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <Border x:Name="OverlapCard" DockPanel.Dock="Left" Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="Taste Overlap" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                                    <TextBlock Text="{Binding OverlapText}" FontSize="44" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="{Binding InCommonText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                    <TextBlock Style="{StaticResource Hint}"
                                                               Text="How much of your listening time and theirs goes to the same artists. Each artist counts for the smaller of its two shares, so 100% would be the same artists in the same proportions." />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="At a Glance" Style="{StaticResource SectionHeader}"
                                                               Margin="0,0,0,8" />
                                                    <DataGrid ItemsSource="{Binding Metrics}" AutomationProperties.Name="Headline figures for you and them"
                                                              SelectionMode="Single" PreviewMouseWheel="OnPassWheelToPage">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="" Binding="{Binding Metric}" Width="1.4*" MinWidth="185" ElementStyle="{StaticResource TrimmedCell}" />
                                                            <DataGridTextColumn Header="You" Binding="{Binding B}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                            <DataGridTextColumn Header="Them" Binding="{Binding A}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                            <DataGridTextColumn Header="You vs them" Binding="{Binding Change}" Width="*" ElementStyle="{StaticResource TrimmedCell}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                        </DockPanel>

                                        <UniformGrid x:Name="PeopleRankings" Columns="2">
                                            <Border Style="{StaticResource Card}" Height="480">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Artists" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                               Text="Ranked by your listening time, with their top artists you don't play at the bottom. Double-click one you've played for your own breakdown." />
                                                    <DataGrid ItemsSource="{Binding Artists}" AutomationProperties.Name="Artists for you and them"
                                                              MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Your #" Binding="{Binding RankB, TargetNullValue=-}" Width="70" MinWidth="70"
                                                                                SortMemberPath="RankB" />
                                                            <DataGridTextColumn Header="Artist" Binding="{Binding Name}" Width="*" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                                                            <DataGridTextColumn Header="Yours" Binding="{Binding HoursB, StringFormat=N1}" Width="65" MinWidth="65"
                                                                                SortMemberPath="MsB" />
                                                            <DataGridTextColumn Header="Theirs" Binding="{Binding HoursA, StringFormat=N1}" Width="70" MinWidth="70"
                                                                                SortMemberPath="MsA" />
                                                            <DataGridTextColumn Header="Their #" Binding="{Binding RankA, TargetNullValue=-}" Width="75" MinWidth="75"
                                                                                SortMemberPath="RankA" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Height="480">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Tracks" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                               Text="The same for tracks. Hours are listening time under the sidebar's filters." />
                                                    <DataGrid ItemsSource="{Binding Tracks}" AutomationProperties.Name="Tracks for you and them"
                                                              MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Your #" Binding="{Binding RankB, TargetNullValue=-}" Width="70" MinWidth="70"
                                                                                SortMemberPath="RankB" />
                                                            <DataGridTextColumn Header="Track" Binding="{Binding Name}" Width="1.4*" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                                                            <DataGridTextColumn Header="Artist" Binding="{Binding Secondary}" Width="*" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                                            <DataGridTextColumn Header="Yours" Binding="{Binding HoursB, StringFormat=N1}" Width="65" MinWidth="65"
                                                                                SortMemberPath="MsB" />
                                                            <DataGridTextColumn Header="Theirs" Binding="{Binding HoursA, StringFormat=N1}" Width="70" MinWidth="70"
                                                                                SortMemberPath="MsA" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                        </UniformGrid>

                                        <UniformGrid x:Name="PeopleLists" Columns="3">
                                            <Border Style="{StaticResource Card}" Height="400">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Most in Common" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                               Text="Artists you both play, those that take a big share of both your listening first." />
                                                    <Grid>
                                                        <DataGrid ItemsSource="{Binding SharedArtists}" AutomationProperties.Name="Artists you both play"
                                                                  MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Artist" Binding="{Binding Name}" Width="*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                                                <DataGridTextColumn Header="Yours" Binding="{Binding HoursB, StringFormat=N1}" Width="65" MinWidth="65"
                                                                                    SortMemberPath="MsB" />
                                                                <DataGridTextColumn Header="Theirs" Binding="{Binding HoursA, StringFormat=N1}" Width="70" MinWidth="70"
                                                                                    SortMemberPath="MsA" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <TextBlock Style="{StaticResource EmptyRows}"
                                                                   Visibility="{Binding SharedArtists, Converter={StaticResource EmptyToVis}}"
                                                                   Text="You have no artist in common." />
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Height="400">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Only You" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                               Text="Artists you played for at least an hour that they never played." />
                                                    <Grid>
                                                        <DataGrid ItemsSource="{Binding NewInB}" AutomationProperties.Name="Artists only you play"
                                                                  MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Artist" Binding="{Binding Name}" Width="*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                                                <DataGridTextColumn Header="Yours" Binding="{Binding HoursB, StringFormat=N1}" Width="65" MinWidth="65"
                                                                                    SortMemberPath="MsB" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <TextBlock Style="{StaticResource EmptyRows}"
                                                                   Visibility="{Binding NewInB, Converter={StaticResource EmptyToVis}}"
                                                                   Text="They've played every artist you spent an hour or more on." />
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Height="400">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Only Them" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                               Text="Artists they played for at least an hour that you never played." />
                                                    <Grid>
                                                        <DataGrid ItemsSource="{Binding GoneSinceA}" AutomationProperties.Name="Artists only they play">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Artist" Binding="{Binding Name}" Width="*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                                                <DataGridTextColumn Header="Theirs" Binding="{Binding HoursA, StringFormat=N1}" Width="70" MinWidth="70"
                                                                                    SortMemberPath="MsA" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <TextBlock Style="{StaticResource EmptyRows}"
                                                                   Visibility="{Binding GoneSinceA, Converter={StaticResource EmptyToVis}}"
                                                                   Text="You've played every artist they spent an hour or more on." />
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- ============================= HISTORY ============================= -->
                    <TabItem x:Name="HistoryTab" Header="History">
                        <Border Style="{StaticResource Card}" DataContext="{Binding History}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Every Play" Style="{StaticResource SectionHeader}" Margin="0" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Updating..." FontSize="11" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Go to" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <DatePicker Width="130" Margin="0,0,14,0" VerticalAlignment="Center"
                                                    SelectedDate="{Binding GoToDate}"
                                                    AutomationProperties.Name="Go to a day"
                                                    ToolTip="Jump to the plays of a day" />
                                        <TextBlock Text="Filter rows" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <TextBox x:Name="HistoryQuickFilter" Width="180"
                                                 AutomationProperties.Name="Filter plays"
                                                 Text="{Binding QuickFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                                 ToolTip="Narrow the plays below by track, artist or album (Ctrl+F)" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,4,0,8" FontSize="11"
                                           Text="Every play that passes the sidebar filters, newest first. Click a column header to sort, and double-click a play, or select it and press Enter, for its track's breakdown." />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding JumpNote}" FontSize="12" Margin="0,0,0,8"
                                           Foreground="{DynamicResource Accent2TextBrush}" views:LiveRegion.Announce="Polite"
                                           Visibility="{Binding JumpNote, Converter={StaticResource TextToVis}}" />
                                <Grid>
                                    <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding Rows}"
                                              AutomationProperties.Name="Every play"
                                              Sorting="OnHistorySorting"
                                              PreviewMouseRightButtonDown="OnGridRightClick"
                                              ContextMenuOpening="OnGridMenuOpening"
                                              MouseDoubleClick="OnGridRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open the track's breakdown" Click="OnOpenPlayTrack" InputGestureText="Enter" />
                                                <MenuItem Header="Open the artist's breakdown" Click="OnOpenPlayArtist" />
                                                <Separator />
                                                <MenuItem Tag="Copy play|Copy {0} plays" Click="OnCopyPlays" />
                                                <MenuItem Tag="Copy Spotify link|Copy {0} Spotify links" Click="OnCopyPlayLinks" />
                                                <Separator />
                                                <MenuItem Tag="Show only this artist|Show only their artists" Click="OnFocusArtistFromPlays" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="When" Binding="{Binding When}" SortMemberPath="When"
                                                                SortDirection="Descending" Width="135" MinWidth="135" />
                                            <DataGridTextColumn Header="Track" Binding="{Binding Track}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="*" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Played" Binding="{Binding Played, Converter={StaticResource HhMmSs}}"
                                                                SortMemberPath="Played" Width="80" MinWidth="80" />
                                            <DataGridTextColumn Header="Ended" Binding="{Binding Ended}" Width="130" MinWidth="130" />
                                            <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="115" MinWidth="115" />
                                            <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="75" MinWidth="75" />
                                            <DataGridTextColumn Binding="{Binding Mode}" SortMemberPath="Mode" Width="0.8*" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="Mode" ToolTip="Whether the play was shuffled, offline or in a private session" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Style="{StaticResource EmptyRows}" Text="{Binding EmptyText}"
                                               Visibility="{Binding Rows, Converter={StaticResource EmptyToVis}}" />
                                    <TextBlock Style="{StaticResource EmptyRows}" Text="Gathering your plays..." Margin="0,82,0,0"
                                               Visibility="{Binding IsGathering, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ============================== Status bar =========================== -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Cancel" Padding="10,3" Margin="8,0,0,0"
                        FontSize="11" Command="{Binding CancelLoadCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+K to jump to anything" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                    <Hyperlink Click="OnShowLoadedFiles"
                               ToolTip="The files your history was read from, what each held, and anything left out"><Run Text="{Binding LoadedFilesText, Mode=OneWay}" /></Hyperlink>
                </TextBlock>
                <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTip="{Binding StatusText}"
                           views:LiveRegion.Announce="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ========================= Jump to (Ctrl+K) ========================== -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              Visibility="{Binding IsJumpOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#99000000" MouseLeftButtonDown="OnJumpBackdropClick" />
            <Border Width="600" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,70,16,16"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" />
                </Border.Effect>
                <DockPanel>
                    <TextBox x:Name="JumpBox" DockPanel.Dock="Top" FontSize="15"
                             Text="{Binding JumpQuery, UpdateSourceTrigger=PropertyChanged, Delay=80}"
                             AutomationProperties.Name="Jump to a track, artist, album or podcast"
                             PreviewKeyDown="OnJumpBoxKeyDown" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding JumpHint}" Style="{StaticResource Hint}"
                               FontSize="11" Margin="2,8,2,0" views:LiveRegion.Announce="Polite"
                               Visibility="{Binding JumpHint, Converter={StaticResource TextToVis}}" />
                    <ListBox x:Name="JumpList" ItemsSource="{Binding JumpResults}" SelectedItem="{Binding SelectedJump}"
                             MaxHeight="440" Margin="0,8,0,0" Focusable="False"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Matches"
                             Visibility="{Binding HasJumpResults, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Cursor" Value="Hand" />
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnJumpItemClick" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="6" Padding="10,6" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Kind}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding Secondary}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="12"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</views:ThemedWindow>
