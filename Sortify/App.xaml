<Application x:Class="Sortify.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Sortify.Views.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the active palette. ThemeService swaps this entry at runtime,
                     which is why everything downstream binds its colours with DynamicResource. -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
            <conv:EmptyStringToVisibilityConverter x:Key="TextToVis" />
            <conv:EmptyCollectionToVisibilityConverter x:Key="EmptyToVis" />
            <conv:DurationConverter x:Key="HhMmSs" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
