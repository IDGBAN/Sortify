<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Sortify</AssemblyName>
    <RootNamespace>Sortify</RootNamespace>
    <Version>3.3.0</Version>
    <Authors>Parsa Rasouli Baghi</Authors>
    <Product>Sortify</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Sortify.ico</ApplicationIcon>
    <!-- LiveCharts pulls SkiaSharp.Views.WPF and OpenTK, which only ship .NET Framework
         assets. They work on net8.0-windows; NU1701 just buries every other warning. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Supports both; pick one with `-r win-x64` or `-r win-x86` when publishing (see README). -->
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.1.0-dev-798" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sortify.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded as a resource: the window style sets it as every window's icon, which
         is what the taskbar and Alt+Tab show. -->
    <Resource Include="Assets\Sortify.ico" />
  </ItemGroup>

</Project>
