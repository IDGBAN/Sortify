<!--
    Light palette. Mirrors every key in Dark.xaml. The accent fills are only darkened from
    the Spotify green/blue as far as white needs; text in those colours has its own darker keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="BgColor">#FFF3F5F7</Color>
    <Color x:Key="PanelColor">#FFFFFFFF</Color>
    <Color x:Key="PanelColor2">#FFEDF0F3</Color>
    <Color x:Key="HoverColor">#FFE0E5EA</Color>
    <Color x:Key="BorderColor">#FFD8DDE3</Color>
    <Color x:Key="ScrollThumbColor">#FFB6BEC7</Color>

    <!-- Accents -->
    <!-- Fills: checkboxes, sliders, toggles, buttons, the tab underline. The brightest green
         and blue that still stand out from white (3:1), matching the chart colours; text on
         them is dark, as on Spotify's own buttons. -->
    <Color x:Key="AccentColor">#FF18A94D</Color>
    <Color x:Key="AccentHoverColor">#FF1DB954</Color>
    <Color x:Key="Accent2Color">#FF4A96F2</Color>
    <Color x:Key="DangerColor">#FFC2410C</Color>

    <!-- Small text in the accent colours (links, ranks, trend labels). The fills above are too
         light to read at that size on white, so these sit darker to clear 4.5:1. -->
    <Color x:Key="AccentTextColor">#FF15803D</Color>
    <Color x:Key="Accent2TextColor">#FF2563EB</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#FF16191D</Color>
    <Color x:Key="MutedColor">#FF64707D</Color>
    <Color x:Key="OnAccentColor">#FF06140B</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelBrush2" Color="{StaticResource PanelColor2}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="Accent2TextBrush" Color="{StaticResource Accent2TextColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />

    <!-- Tinted accent used for selected grid rows. -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF18A94D" Opacity="0.18" />

</ResourceDictionary>
