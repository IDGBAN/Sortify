<!--
    Dark palette. Light.xaml declares the same keys with different values; ThemeService
    swaps whichever one is merged at index 0 of the application resources, and every
    style in Controls.xaml reaches these through DynamicResource so the swap is live.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="BgColor">#FF121212</Color>
    <Color x:Key="PanelColor">#FF181818</Color>
    <Color x:Key="PanelColor2">#FF242424</Color>
    <Color x:Key="HoverColor">#FF2E2E2E</Color>
    <Color x:Key="BorderColor">#FF2C2C2C</Color>
    <Color x:Key="ScrollThumbColor">#FF4A4A4A</Color>

    <!-- Accents -->
    <Color x:Key="AccentColor">#FF1DB954</Color>
    <Color x:Key="AccentHoverColor">#FF1ED760</Color>
    <Color x:Key="Accent2Color">#FF509CF8</Color>
    <Color x:Key="DangerColor">#FFE76F51</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#FFEDEDED</Color>
    <Color x:Key="MutedColor">#FF9A9A9A</Color>
    <Color x:Key="OnAccentColor">#FF06140B</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelBrush2" Color="{StaticResource PanelColor2}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />

    <!-- Tinted accent used for selected grid rows. -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF1DB954" Opacity="0.20" />

</ResourceDictionary>
